#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
cd "$repo_root"

# Shared repository contract (identity, LICENSE, .gitignore, remote checks)
# is vendored from cgraf78/actions capability-harness. The actions lock and
# ShellCheck inventory are enforced by the `cgraf78/actions sync` job and
# shell CI's shellcheck-inventory; this script owns only the dev overlay's
# own workflow shape and runner invariants.
# shellcheck source=test/lib/workflow-contract.sh
. "$repo_root/test/lib/workflow-contract.sh"
workflow_contract_init dotfiles-dev
workflow_contract_dispatch_predicate "$@"
workflow_contract_count_run

required_files=(
  .selene.toml vim.yml
  .github/cgraf78-actions.lock .github/dependabot.yml
  .github/dot-test-suites.txt
  .github/shellcheck-files.txt
  .github/workflows/retry-infrastructure.yml .github/workflows/test.yml
  .gitignore LICENSE README.md test/run test/workflow-test
  test/lib/capability-harness.conf test/lib/.capability-harness.manifest
)
for path in "${required_files[@]}"; do [[ -f $path ]] || fail "missing required file: $path"; done

# The vendored capability harness owns the Dot release policy: it floats to the
# latest checksum-verified release per run, and verify-consumer-sync holds its
# bytes to the actions lock. Keep the runner on that shared installer and keep
# a concrete release pin from creeping back in through the runner or workflows.
# shellcheck disable=SC2016 # Match the literal installer call.
grep -F 'capability_dot_release_install "$dot_checkout"' test/run >/dev/null ||
  fail 'capability tests do not install Dot through the shared release helper'
if grep -Eq "DOT_TEST_DOT_RELEASE_TAG[\"']?[[:space:]]*(:-|:|=)[[:space:]]*[\"']?[0-9]{8}-[0-9]{6}-[0-9a-f]{8}" \
  test/run .github/workflows/*.yml; then
  fail 'capability tests pin a concrete Dot release instead of floating to latest'
fi

workflow_contract_check_files
workflow_contract_check_inventory_programs .github/shellcheck-files.txt
selene_policy_hash=$(sha256sum home/.config/checkrun/selene.toml 2>/dev/null |
  awk '{print $1}' || shasum -a 256 home/.config/checkrun/selene.toml | awk '{print $1}')
[[ $selene_policy_hash == 4001d244c811c7f0c94dca6f77d3796c77f8d2fef8dede15d7831748b5f923b0 ]] ||
  fail 'deployed Selene policy differs from the repository fallback'
grep -Fx 'std = "vim+lua51"' .selene.toml >/dev/null ||
  fail 'repository-only Selene config does not select the Neovim standard library'

workflow=.github/workflows/test.yml
grep -Fx 'name: Tests' "$workflow" >/dev/null || fail 'test workflow name drifted'
grep -Fx '    - cron: "37 9 * * *"' "$workflow" >/dev/null || fail 'nightly schedule drifted'
grep -Fx '      setup: none' "$workflow" >/dev/null || fail 'capability CI must use setup: none'
grep -Fx '      matrix-set: full' "$workflow" >/dev/null || fail 'capability CI must use the full matrix'
grep -Fx '      profiles: base,jq,python,lua,neovim,zsh,procps' "$workflow" >/dev/null || fail 'capability prerequisite profile drifted'
grep -Fx '      test-command: test/run' "$workflow" >/dev/null || fail 'full suite runner is not wired'
grep -Fx '      termux-command: test/run --termux' "$workflow" >/dev/null || fail 'Termux smoke command is not explicit'
grep -Fx '    name: cgraf78/actions sync' "$workflow" >/dev/null || fail 'actions-sync job is missing'
grep -Fx '          persist-credentials: false' "$workflow" >/dev/null || fail 'checkout credentials must not persist'
if grep -F 'setup: dotfiles' "$workflow" >/dev/null; then fail 'overlay CI must not bootstrap the base dotfiles repository'; fi

# verify-consumer-sync holds every cgraf78/actions ref to the lock; these
# only require that the shared jobs stay wired at all.
grep -F 'uses: cgraf78/actions/.github/workflows/shell-ci.yml@' "$workflow" >/dev/null || fail 'shared shell workflow ref is missing'
grep -F 'uses: cgraf78/actions/.github/actions/verify-consumer-sync@' "$workflow" >/dev/null || fail 'actions sync ref is missing'
grep -Fx '      shellcheck-inventory-path: .github/shellcheck-files.txt' "$workflow" >/dev/null || fail 'shell CI does not lint the typed ShellCheck inventory'
grep -Fx '        run: test/workflow-test --remote' "$workflow" >/dev/null || fail 'remote license check is missing'
grep -F 'uses: cgraf78/actions/.github/actions/infra-retry@' .github/workflows/retry-infrastructure.yml >/dev/null || fail 'retry action ref is missing'
grep -F 'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1' "$workflow" >/dev/null || fail 'checkout pin drifted'
grep -F 'android-dev-ci-smoke' test/run >/dev/null || fail 'Termux dev smoke test is not wired into the runner'
grep -F 'for dependency in difftastic direnv lazygit mise yq watchexec; do' \
  home/.local/lib/dotfiles/tests/android-dev-ci-smoke >/dev/null ||
  fail 'Termux smoke lacks substantive watchexec policy coverage'
if grep -E '^required_commands=.*(^|[[:space:]])cmp([[:space:]]|$)' test/run >/dev/null; then
  fail 'controlled runtime PATH must not require cmp after bootstrap validation'
fi

grep -Fx '  provider-compatibility:' "$workflow" >/dev/null || fail 'provider compatibility job is missing'
grep -Fx '        run: test/run --provider-compatibility' "$workflow" >/dev/null ||
  fail 'provider compatibility runner is not wired'
grep -F 'watchexec/releases/download/v2.7.0/watchexec-2.7.0-x86_64-unknown-linux-gnu.tar.xz' \
  "$workflow" >/dev/null || fail 'Watchexec compatibility artifact is not version-pinned'
grep -F '2590f2d13e6a5a2210f4bf3fada9542263fbcea77604921bf28aada3bc7513d1' \
  "$workflow" >/dev/null || fail 'Watchexec compatibility checksum drifted'
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
watchexec_verify_line=$(grep -nF '          xz --test "$archive"' "$workflow" | cut -d: -f1)
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
watchexec_extract_line=$(grep -nF '          tar -xJf "$archive"' "$workflow" | cut -d: -f1)
[[ -n $watchexec_verify_line && -n $watchexec_extract_line &&
  $watchexec_verify_line -lt $watchexec_extract_line ]] ||
  fail 'Watchexec archive integrity is not checked before extraction'
grep -F 'mikefarah/yq/releases/download/v4.53.6/yq_linux_amd64' "$workflow" >/dev/null ||
  fail 'yq compatibility runtime is not version-pinned'
grep -F 'c5f056448f973ae7d39b5401949648a78f2dc1947d6a8eb65be60d5c504b9385' \
  "$workflow" >/dev/null || fail 'yq compatibility checksum drifted'
grep -F 'provider compatibility did not execute the real-yq merge block' \
  test/run >/dev/null || fail 'provider compatibility does not enforce real-yq merge coverage'
grep -F 'provider compatibility did not execute the real-Node projection block' \
  test/run >/dev/null || fail 'provider compatibility does not enforce real-Node projection coverage'
grep -F 'provider compatibility did not execute the live retirement-history guard' \
  test/run >/dev/null || fail 'provider compatibility does not enforce live history coverage'
# shellcheck disable=SC2016 # Match the literal GitHub Actions expression.
grep -F 'CAPABILITY_TEST_NODE: ${{ runner.temp }}/node-provider' "$workflow" >/dev/null ||
  fail 'provider compatibility does not receive an explicit Node runtime'
primary_checkout=$'      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        # Name checkout\'s throwaway initial branch so Git skips its hint.\n        env:\n          GIT_CONFIG_COUNT: "1"\n          GIT_CONFIG_KEY_0: init.defaultBranch\n          GIT_CONFIG_VALUE_0: main\n        with:\n          fetch-depth: 0\n          persist-credentials: false'
# Match the step as one block: `grep -F` would split this pattern at each
# newline and accept any single line, hiding a dropped `fetch-depth: 0`.
[[ $(<"$workflow") == *"$primary_checkout"* ]] ||
  fail 'provider compatibility primary checkout does not fetch development history'
grep -F 'neovim/releases/download/v0.12.2/nvim-linux-x86_64.tar.gz' "$workflow" >/dev/null ||
  fail 'provider compatibility Neovim is not version-pinned'
grep -F 'fe333ad1dddfeb4b15169859287369207443477288737d4b94c07df7647ae21e' \
  "$workflow" >/dev/null || fail 'provider compatibility Neovim checksum drifted'
grep -F '31cf85945cb600d96cdf69f88bc68bec814acbff50863c5546adef3a1bcef260' \
  "$workflow" >/dev/null || fail 'provider compatibility Neovim archive checksum drifted'
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
nvim_archive_verify_line=$(grep -nF '            "$archive" | sha256sum --check --strict' \
  "$workflow" | head -1 | cut -d: -f1)
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
nvim_extract_line=$(grep -nF '          tar -xzf "$archive"' "$workflow" | cut -d: -f1)
[[ -n $nvim_archive_verify_line && -n $nvim_extract_line &&
  $nvim_archive_verify_line -lt $nvim_extract_line ]] ||
  fail 'provider compatibility Neovim archive is not verified before extraction'
# shellcheck disable=SC2016 # Match the literal GitHub Actions expression.
grep -F 'CAPABILITY_TEST_NVIM: ${{ runner.temp }}/neovim-0.12.2/bin/nvim' \
  "$workflow" >/dev/null || fail 'provider compatibility does not receive explicit Neovim'
grep -F '    nvim-dev' test/run >/dev/null ||
  fail 'provider compatibility does not execute nvim-dev coverage'
provider_checkout_ref() {
  local repository=$1
  awk -v repository="cgraf78/$repository" '
    $1 == "repository:" {
      in_checkout = ($2 == repository)
      if (in_checkout) found++
      next
    }
    in_checkout && $1 == "ref:" {
      refs++
      value = $2
      in_checkout = 0
    }
    END {
      if (found == 1 && refs == 1) print value
      else exit 1
    }
  ' "$workflow"
}
for provider in checkrun sley git_tools agentguard; do
  repository=${provider//_/-}
  [[ $(provider_checkout_ref "$repository") == main ]] ||
    fail "provider checkout does not follow current main: $repository"
done

# Dot client hooks under dot/ carry no extension and may carry no shebang,
# so shellcheck-inventory can only discover them by a shell directive. Keep
# every one of them inventoried so a new hook cannot skip linting silently.
while IFS= read -r -d '' dot_hook; do
  grep -Fxq "program"$'\t'"$dot_hook" .github/shellcheck-files.txt ||
    fail "Dot hook is missing from the ShellCheck inventory: $dot_hook"
done < <(find dot -type f -print0)

test/lib/wait-github-state.sh --self-test
test/lib/capability-fixture.sh --self-test
test/run --inventory-self-test
grep -F 'gitleaks dir . --config home/.gitleaks.toml' README.md >/dev/null ||
  fail 'documented working-tree secret scan must use the overlay config'
grep -F 'gitleaks git . --config home/.gitleaks.toml' README.md >/dev/null ||
  fail 'documented history secret scan must use the overlay config'

# shellcheck disable=SC2016 # Match the literal fixture call.
grep -Fx 'capability_fixture_create "$fixture_home" "$repo_root" 30-dev.conf' test/run >/dev/null ||
  fail 'capability fixture does not use the 30-dev.conf descriptor'

suite_count=$(awk 'NF && $1 !~ /^#/ { count++ } END { print count+0 }' .github/dot-test-suites.txt)
((suite_count > 0)) || fail 'capability repository requires a non-empty suite inventory'

if [[ ${1:-} == --remote ]]; then
  workflow_contract_poll_remote "$repo_root/test/workflow-test"
fi

printf 'workflow-test: contract is complete\n'
