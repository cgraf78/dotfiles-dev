#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
cd "$repo_root"

resolve_repo_name() {
  local root=$1 github_repository=${2:-} remote=${3:-}
  if [[ -n $github_repository ]]; then
    printf '%s\n' "${github_repository##*/}"
  elif [[ -n $remote ]]; then
    remote=${remote##*/}
    printf '%s\n' "${remote%.git}"
  else
    printf '%s\n' "${root##*/}"
  fi
}

[[ $(resolve_repo_name /tmp/project cgraf78/dotfiles-dev) == dotfiles-dev ]] || {
  printf 'workflow-test: GitHub repository identity did not override checkout basename\n' >&2
  exit 1
}
[[ $(resolve_repo_name /tmp/project '' git@github.com:cgraf78/dotfiles-dev.git) == dotfiles-dev ]] || {
  printf 'workflow-test: origin identity did not override checkout basename\n' >&2
  exit 1
}
repo_remote=$(git config --get remote.origin.url)
repo_name=$(resolve_repo_name "$repo_root" "${GITHUB_REPOSITORY:-}" "$repo_remote")

fail() {
  printf 'workflow-test: %s\n' "$*" >&2
  exit 1
}

validate_actions_refs() {
  local workflows_dir=$1 expected=$2 ref found=0
  while IFS= read -r ref; do
    found=$((found + 1))
    [[ $ref == *@* && ${ref##*@} == "$expected" ]] || return 1
  done < <(grep -rho 'cgraf78/actions/[^[:space:]#]*' "$workflows_dir" | LC_ALL=C sort -u)
  ((found > 0))
}

case $repo_name in
  dotfiles-nvim)
    expected_cron='23 9 * * *'
    descriptor=20-nvim.conf
    expected_profiles=base,jq,python,lua,neovim,tmux,ripgrep,fd,procps
    ;;
  dotfiles-dev)
    expected_cron='37 9 * * *'
    descriptor=30-dev.conf
    expected_profiles=base,jq,python,lua,neovim,zsh,procps
    ;;
  *) fail "unexpected repository name: $repo_name" ;;
esac

remote_predicate() {
  local remote_tmp
  command -v gh >/dev/null || fail 'gh is required for remote validation'
  [[ $(gh api "repos/cgraf78/$repo_name" --jq .visibility) == public ]] || fail 'remote repository is not public'
  [[ $(gh api "repos/cgraf78/$repo_name" --jq .default_branch) == main ]] || fail 'remote default branch is not main'
  [[ $(gh api "repos/cgraf78/$repo_name/license" --jq .license.spdx_id) == MIT ]] || fail 'remote license is not MIT'
  remote_tmp=$(mktemp -d)
  trap 'rm -rf -- "$remote_tmp"' RETURN
  gh api --method GET repos/cgraf78/dotfiles/contents/.github/LICENSE \
    -f ref=12ffa6b4ec3cd95b3d52f4d9fe62cf1c10d37dea --jq .content |
    base64 --decode >"$remote_tmp/source-LICENSE"
  gh api --method GET "repos/cgraf78/$repo_name/contents/LICENSE" --jq .content |
    base64 --decode >"$remote_tmp/target-LICENSE"
  cmp LICENSE "$remote_tmp/source-LICENSE" || fail 'local license differs from immutable source'
  cmp "$remote_tmp/target-LICENSE" "$remote_tmp/source-LICENSE" || fail 'remote license bytes differ from immutable source'
}

if [[ ${1:-} == --remote-predicate ]]; then
  remote_predicate
  exit 0
fi

if [[ -n ${WORKFLOW_TEST_COUNT_FILE:-} ]]; then
  count=0
  [[ ! -f $WORKFLOW_TEST_COUNT_FILE ]] || count=$(<"$WORKFLOW_TEST_COUNT_FILE")
  printf '%s\n' "$((count + 1))" >"$WORKFLOW_TEST_COUNT_FILE"
fi

required_files=(
  .selene.toml vim.yml
  .github/cgraf78-actions.lock .github/dependabot.yml .github/dot.lock
  .github/provider-test.lock
  .github/dot-test-suites.txt .github/dotfiles-source.lock
  .github/repository-settings-endpoints.txt .github/shellcheck-files.txt
  .github/workflows/retry-infrastructure.yml .github/workflows/test.yml
  .gitignore LICENSE README.md test/run test/workflow-test
  test/lib/capability-fixture.sh test/lib/repository-settings.sh
  test/lib/wait-github-state.sh
)
for path in "${required_files[@]}"; do [[ -f $path ]] || fail "missing required file: $path"; done

single_sha() {
  local file=$1 expected=$2 value
  [[ $(wc -l <"$file" | tr -d '[:space:]') == 1 ]] || fail "$file must contain exactly one line"
  value=$(<"$file")
  [[ $value =~ ^[0-9a-f]{40}$ ]] || fail "$file does not contain a full lowercase commit SHA"
  [[ $value == "$expected" ]] || fail "$file contains an unexpected commit SHA"
}
single_sha .github/cgraf78-actions.lock de3f6086e36a77eec8ee62f2c9871266e4b5c05c
single_sha .github/dot.lock 3248f8db8182dd6cff3c2993315d28afbecec50d

expected_source=$'version=1\nrepository=cgraf78/dotfiles\ncommit=12ffa6b4ec3cd95b3d52f4d9fe62cf1c10d37dea\nlicense_path=.github/LICENSE'
[[ $(<.github/dotfiles-source.lock) == "$expected_source" ]] || fail 'source lock is not canonical'
if LC_ALL=C grep -q $'\r' .github/dotfiles-source.lock; then fail 'source lock contains CRLF'; fi

if command -v sha256sum >/dev/null 2>&1; then
  license_hash=$(sha256sum LICENSE | awk '{print $1}')
else
  license_hash=$(shasum -a 256 LICENSE | awk '{print $1}')
fi
[[ $license_hash == bfaed6d8fb29d7208c1266afa313681591d6ca05ec2f7e005cebe3d7a7b43579 ]] || fail 'LICENSE bytes differ from the frozen MIT license'
[[ $(wc -c <LICENSE | tr -d '[:space:]') == 1067 ]] || fail 'LICENSE size differs from the frozen MIT license'
if [[ -n ${DOTFILES_SOURCE_REPO:-} ]]; then
  git -C "$DOTFILES_SOURCE_REPO" cat-file -e '12ffa6b4ec3cd95b3d52f4d9fe62cf1c10d37dea^{commit}'
  cmp LICENSE <(git -C "$DOTFILES_SOURCE_REPO" show 12ffa6b4ec3cd95b3d52f4d9fe62cf1c10d37dea:.github/LICENSE)
  cmp .github/dependabot.yml <(git -C "$DOTFILES_SOURCE_REPO" show 12ffa6b4ec3cd95b3d52f4d9fe62cf1c10d37dea:.github/dependabot.yml)
  cmp .github/workflows/retry-infrastructure.yml <(git -C "$DOTFILES_SOURCE_REPO" show 12ffa6b4ec3cd95b3d52f4d9fe62cf1c10d37dea:.github/workflows/retry-infrastructure.yml)
fi
selene_policy_hash=$(sha256sum home/.config/checkrun/selene.toml 2>/dev/null |
  awk '{print $1}' || shasum -a 256 home/.config/checkrun/selene.toml | awk '{print $1}')
[[ $selene_policy_hash == 4001d244c811c7f0c94dca6f77d3796c77f8d2fef8dede15d7831748b5f923b0 ]] ||
  fail 'deployed Selene policy differs from the frozen source'
grep -Fx 'std = "vim+lua51"' .selene.toml >/dev/null ||
  fail 'repository-only Selene config does not select the Neovim standard library'
[[ $(<.gitignore) == '.worktrees/' ]] || fail '.gitignore must contain only .worktrees/'
manifest_hash=$(sha256sum .github/repository-settings-endpoints.txt 2>/dev/null | awk '{print $1}' || shasum -a 256 .github/repository-settings-endpoints.txt | awk '{print $1}')
[[ $manifest_hash == 1014be04ef3f99d20570369cdc0831d4f75571882d2d4797b7d817cd43ff21c7 ]] || fail 'repository settings endpoint contract drifted'

workflow=.github/workflows/test.yml
grep -Fx 'name: Tests' "$workflow" >/dev/null || fail 'test workflow name drifted'
grep -Fx "    - cron: \"$expected_cron\"" "$workflow" >/dev/null || fail 'nightly schedule drifted'
grep -Fx '      setup: none' "$workflow" >/dev/null || fail 'capability CI must use setup: none'
grep -Fx '      matrix-set: full' "$workflow" >/dev/null || fail 'capability CI must use the full matrix'
grep -Fx "      profiles: $expected_profiles" "$workflow" >/dev/null || fail 'capability prerequisite profile drifted'
grep -Fx '      test-command: test/run' "$workflow" >/dev/null || fail 'full suite runner is not wired'
grep -Fx '      termux-command: test/run --termux' "$workflow" >/dev/null || fail 'Termux smoke command is not explicit'
grep -Fx '    name: cgraf78/actions sync' "$workflow" >/dev/null || fail 'actions-sync job is missing'
grep -Fx '          persist-credentials: false' "$workflow" >/dev/null || fail 'checkout credentials must not persist'
if grep -F 'setup: dotfiles' "$workflow" >/dev/null; then fail 'overlay CI must not bootstrap the base dotfiles repository'; fi

actions_sha=$(<.github/cgraf78-actions.lock)
validate_actions_refs .github/workflows "$actions_sha" || fail 'a cgraf78/actions ref is missing or differs from the lock'
refs_tmp=$(mktemp -d)
trap 'rm -rf -- "$refs_tmp"' EXIT HUP INT TERM
printf 'uses: cgraf78/actions/.github/actions/example@main\n' >"$refs_tmp/bad.yml"
if validate_actions_refs "$refs_tmp" "$actions_sha"; then fail 'moving cgraf78/actions ref was accepted'; fi
rm -rf -- "$refs_tmp"
trap - EXIT HUP INT TERM
grep -F "shell-ci.yml@$actions_sha" "$workflow" >/dev/null || fail 'shared shell workflow ref is missing'
grep -F "verify-consumer-sync@$actions_sha" "$workflow" >/dev/null || fail 'actions sync ref is missing'
grep -Fx '        run: test/workflow-test --remote' "$workflow" >/dev/null || fail 'remote license check is missing'
grep -F 'wait_github_state 120 3' test/workflow-test >/dev/null || fail 'remote checks must use bounded polling'
grep -F "infra-retry@$actions_sha" .github/workflows/retry-infrastructure.yml >/dev/null || fail 'retry action ref is missing'
grep -F 'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1' "$workflow" >/dev/null || fail 'checkout pin drifted'
grep -F 'android-dev-ci-smoke' test/run >/dev/null || fail 'Termux dev smoke test is not wired into the runner'
grep -F 'for dependency in difftastic direnv lazygit mise yq watchexec; do' \
  home/.local/lib/dotfiles/tests/android-dev-ci-smoke >/dev/null ||
  fail 'Termux smoke lacks substantive watchexec policy coverage'
if grep -E '^required_commands=.*(^|[[:space:]])cmp([[:space:]]|$)' test/run >/dev/null; then
  fail 'controlled runtime PATH must not require cmp after bootstrap validation'
fi

expected_provider_lock=$'version=1\ncheckrun=638c4dc8a1012c4552a1c42e412a310b8c175c70\nsley=7cf7b2ed9b3b3f68b22e5ac1d6edcc5f652d7125\ngit_tools=7434dd9072906812084270debc55e63568626463\nagentguard=02ec2f41907cabd344c7fbdf57300dcc969e3a3f'
[[ $(<.github/provider-test.lock) == "$expected_provider_lock" ]] ||
  fail 'provider compatibility lock is not canonical'
grep -Fx '  provider-compatibility:' "$workflow" >/dev/null || fail 'provider compatibility job is missing'
grep -Fx '        run: test/run --provider-compatibility' "$workflow" >/dev/null ||
  fail 'provider compatibility runner is not wired'
grep -F 'watchexec/releases/download/v2.7.0/watchexec-2.7.0-x86_64-unknown-linux-gnu.tar.xz' \
  "$workflow" >/dev/null || fail 'Watchexec compatibility artifact is not version-pinned'
grep -F '2590f2d13e6a5a2210f4bf3fada9542263fbcea77604921bf28aada3bc7513d1' \
  "$workflow" >/dev/null || fail 'Watchexec compatibility checksum drifted'
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
watchexec_verify_line=$(grep -nF '          xz --test "$archive"' "$workflow" | cut -d: -f1)
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
watchexec_extract_line=$(grep -nF '          tar -xJf "$archive"' "$workflow" | cut -d: -f1)
[[ -n $watchexec_verify_line && -n $watchexec_extract_line &&
  $watchexec_verify_line -lt $watchexec_extract_line ]] ||
  fail 'Watchexec archive integrity is not checked before extraction'
grep -F 'mikefarah/yq/releases/download/v4.53.6/yq_linux_amd64' "$workflow" >/dev/null ||
  fail 'yq compatibility runtime is not version-pinned'
grep -F 'c5f056448f973ae7d39b5401949648a78f2dc1947d6a8eb65be60d5c504b9385' \
  "$workflow" >/dev/null || fail 'yq compatibility checksum drifted'
grep -F 'provider compatibility did not execute the real-yq merge block' \
  test/run >/dev/null || fail 'provider compatibility does not enforce real-yq merge coverage'
grep -F 'provider compatibility did not execute the real-Node projection block' \
  test/run >/dev/null || fail 'provider compatibility does not enforce real-Node projection coverage'
grep -F 'provider compatibility did not execute the live retirement-history guard' \
  test/run >/dev/null || fail 'provider compatibility does not enforce live history coverage'
# shellcheck disable=SC2016 # Match the literal GitHub Actions expression.
grep -F 'CAPABILITY_TEST_NODE: ${{ runner.temp }}/node-provider' "$workflow" >/dev/null ||
  fail 'provider compatibility does not receive an explicit Node runtime'
primary_checkout=$'      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false'
grep -F "$primary_checkout" "$workflow" >/dev/null ||
  fail 'provider compatibility primary checkout does not fetch development history'
grep -F 'neovim/releases/download/v0.12.2/nvim-linux-x86_64.tar.gz' "$workflow" >/dev/null ||
  fail 'provider compatibility Neovim is not version-pinned'
grep -F 'fe333ad1dddfeb4b15169859287369207443477288737d4b94c07df7647ae21e' \
  "$workflow" >/dev/null || fail 'provider compatibility Neovim checksum drifted'
grep -F '31cf85945cb600d96cdf69f88bc68bec814acbff50863c5546adef3a1bcef260' \
  "$workflow" >/dev/null || fail 'provider compatibility Neovim archive checksum drifted'
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
nvim_archive_verify_line=$(grep -nF '            "$archive" | sha256sum --check --strict' \
  "$workflow" | head -1 | cut -d: -f1)
# shellcheck disable=SC2016 # Match the literal workflow shell, not this test's variables.
nvim_extract_line=$(grep -nF '          tar -xzf "$archive"' "$workflow" | cut -d: -f1)
[[ -n $nvim_archive_verify_line && -n $nvim_extract_line &&
  $nvim_archive_verify_line -lt $nvim_extract_line ]] ||
  fail 'provider compatibility Neovim archive is not verified before extraction'
# shellcheck disable=SC2016 # Match the literal GitHub Actions expression.
grep -F 'CAPABILITY_TEST_NVIM: ${{ runner.temp }}/neovim-0.12.2/bin/nvim' \
  "$workflow" >/dev/null || fail 'provider compatibility does not receive explicit Neovim'
grep -F '    nvim-dev' test/run >/dev/null ||
  fail 'provider compatibility does not execute nvim-dev coverage'
while IFS='=' read -r provider sha; do
  case $provider in version) continue ;; esac
  repository=${provider//_/-}
  grep -F "          repository: cgraf78/$repository" "$workflow" >/dev/null ||
    fail "provider checkout is missing: $repository"
  grep -F "          ref: $sha" "$workflow" >/dev/null ||
    fail "provider checkout pin drifted: $repository"
done <.github/provider-test.lock

declare -a expected_shell_files=()
declare -a actual_shell_files=()
while IFS= read -r -d '' path; do
  case $path in
    dot/*)
      expected_shell_files+=("$path")
      ;;
    *.sh | *.bash | *.bats | *.dash | *.ksh)
      expected_shell_files+=("$path")
      ;;
    *)
      IFS= read -r first_line <"$path" || true
      case $first_line in
        '#!'*bash* | '#!'*/sh) expected_shell_files+=("$path") ;;
      esac
      ;;
  esac
done < <(find dot home test -type f -print0)
while IFS=$'\t' read -r type path extra; do
  case $type in '' | \#*) continue ;; esac
  [[ $type == program && -n $path && -z ${extra:-} ]] || fail 'invalid typed ShellCheck inventory record'
  [[ -f $path ]] || fail "ShellCheck inventory path is missing: $path"
  actual_shell_files+=("$path")
done <.github/shellcheck-files.txt
mapfile -t expected_shell_files < <(printf '%s\n' "${expected_shell_files[@]}" | LC_ALL=C sort)
mapfile -t actual_shell_files < <(printf '%s\n' "${actual_shell_files[@]}" | LC_ALL=C sort)
[[ ${actual_shell_files[*]} == "${expected_shell_files[*]}" ]] || fail 'typed ShellCheck inventory is incomplete or contains extras'

test/lib/repository-settings.sh validate
test/lib/repository-settings.sh --self-test
test/lib/wait-github-state.sh --self-test
test/lib/capability-fixture.sh --self-test
test/run --inventory-self-test
grep -F 'gitleaks dir . --config home/.gitleaks.toml' README.md >/dev/null ||
  fail 'documented working-tree secret scan must use the overlay config'
grep -F 'gitleaks git . --config home/.gitleaks.toml' README.md >/dev/null ||
  fail 'documented history secret scan must use the overlay config'

descriptor_path=".config/dot/overlays.d/$descriptor"
case $descriptor_path in
  .config/dot/overlays.d/20-nvim.conf | .config/dot/overlays.d/30-dev.conf) ;;
  *) fail 'unexpected capability descriptor path' ;;
esac

suite_count=$(awk 'NF && $1 !~ /^#/ { count++ } END { print count+0 }' .github/dot-test-suites.txt)
case ${DOTFILES_CAPABILITY_PHASE:-final} in
  bootstrap) ;;
  final) ((suite_count > 0)) || fail 'final mode requires a non-empty suite inventory' ;;
  *) fail 'DOTFILES_CAPABILITY_PHASE must be bootstrap or final' ;;
esac

if [[ ${1:-} == --remote ]]; then
  # shellcheck source=test/lib/wait-github-state.sh
  . "$repo_root/test/lib/wait-github-state.sh"
  wait_github_state 120 3 "$repo_root/test/workflow-test" --remote-predicate
fi

printf 'workflow-test: bootstrap contract is complete\n'
