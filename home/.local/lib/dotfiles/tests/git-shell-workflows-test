#!/usr/bin/env bash
# Verify the dev overlay's consumer boundary for Git and git-tools.
set -euo pipefail
export NO_COLOR=1
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

echo '=== Git shell workflow boundary ==='
deps=$(<"$HOME/.config/shdeps/30-dev.conf")
aliases=$(<"$HOME/.config/shell/interactive.d/70-dev-aliases.sh")
integrations=$(<"$HOME/.config/shell/interactive.d/80-dev-integrations.bash")

_assert_contains 'git-tools is selected by dev' 'cgraf78/git-tools' "$deps"
_assert_contains 'Lazygit is selected by dev' 'jesseduffield/lazygit' "$deps"
_assert_contains 'Git log alias is dev-owned' "alias gl='git log" "$aliases"
_assert_contains 'VS Code alias is dev-owned' "alias vs='code'" "$aliases"
_assert_contains 'Lazygit wrapper is dev-owned' 'lg()' "$aliases"
_assert_contains 'git-tools shell provider is loaded' '_tool_init git-tools' "$integrations"
_test_summary
