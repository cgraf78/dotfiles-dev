#!/usr/bin/env bash
# validate-commit-msg-test — unit tests for dotfiles message policy and its
# Sley-backed Git hook.
#
# Tests the internal policy provider directly and through the Git commit-msg
# hook (end-to-end). Covers both Git and Sapling formats, strict/non-strict
# modes, the Sley provider seam, and edge cases.
#
# Usage: commit-msg-test

set -o pipefail
export NO_COLOR=1

# shellcheck source=dev/helpers.sh
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

OWNER_ROOT=$(_dev_repo_root)
SOURCE_HOME=$OWNER_ROOT/home
VALIDATOR="$SOURCE_HOME/.local/lib/dotfiles/sley-hooks/validate-commit-msg"
# Exercise the hook selected by the tracked Git configuration rather than a
# second test-owned path. A storage-only refactor must preserve this behavior.
# Expand its `~` against the checkout under test; the live HOME would select
# the installed hooks instead of the ones being changed. Expand by hand: a
# fixture HOME would make the dotfiles Git launcher write caches into the
# checkout.
HOOK_DIR=$(git config --file "$SOURCE_HOME/.config/git/config" \
  --get core.hooksPath)
HOOK_DIR=${HOOK_DIR/#\~/$SOURCE_HOME}
COMMIT_MSG_HOOK="$HOOK_DIR/commit-msg"
DOT_SLEY_ROOT=${DOT_TEST_SLEY_ROOT:-}
if [[ -z $DOT_SLEY_ROOT ]]; then
  DOT_SLEY_ROOT=$(_tmpdir)
  mkdir -p "$DOT_SLEY_ROOT/bin" "$DOT_SLEY_ROOT/share/sley/hooks/git"
  cat >"$DOT_SLEY_ROOT/bin/sley" <<'EOF'
#!/usr/bin/env bash
set -u
case ${1:-} in
  secrets) exit 0 ;;
  hook)
    [[ ${2:-} == validate-message ]] || exit 2
    shift 2
    validator=
    message_file=
    while (($#)); do
      case $1 in
        --validator) validator=${2:-}; shift 2 ;;
        --message-file) message_file=${2:-}; shift 2 ;;
        *) exit 2 ;;
      esac
    done
    [[ -x $validator && -n $message_file ]] || exit 2
    exec "$validator" "$message_file"
    ;;
  *) exit 2 ;;
esac
EOF
  cat >"$DOT_SLEY_ROOT/share/sley/hooks/git/commit-msg" <<'EOF'
#!/usr/bin/env bash
set -u
message_file=${1:-}
[[ -n $message_file ]] || exit 2
validation_rc=0
if [[ -n ${SLEY_COMMIT_MESSAGE_VALIDATOR:-} ]]; then
  sley hook validate-message --validator "$SLEY_COMMIT_MESSAGE_VALIDATOR" \
    --message-file "$message_file" || validation_rc=$?
fi
sley secrets --message-file "$message_file" || exit "$?"
exit "$validation_rc"
EOF
  chmod +x "$DOT_SLEY_ROOT/bin/sley" \
    "$DOT_SLEY_ROOT/share/sley/hooks/git/commit-msg"
fi
SLEY_TEST_REAL_BIN="$DOT_SLEY_ROOT/bin/sley"
DOT_TEST_COMMIT_MSG_HOOK=$COMMIT_MSG_HOOK
export DOT_SLEY_ROOT SLEY_TEST_REAL_BIN DOT_TEST_COMMIT_MSG_HOOK

if [ ! -x "$VALIDATOR" ]; then
  echo "commit-msg-test: validator not found at $VALIDATOR" >&2
  exit 1
fi
if [ ! -x "$COMMIT_MSG_HOOK" ]; then
  echo "commit-msg-test: commit-msg hook not found at $COMMIT_MSG_HOOK" >&2
  exit 1
fi
if [ ! -x "$SLEY_TEST_REAL_BIN" ]; then
  echo "commit-msg-test: Sley development/runtime binary not found at $SLEY_TEST_REAL_BIN" >&2
  exit 1
fi

# Clear knobs so the user's env doesn't leak in.
unset COMMIT_MSG_SKIP COMMIT_MSG_STRICT GITHOOK_COMMITMSG_SKIP

# Run the validator with given format/flags, message on stdin.
# Sets __VAL_OUT and __VAL_RC.
_validate() {
  local msg="$1"
  shift
  __VAL_OUT=$(printf '%s\n' "$msg" | "$VALIDATOR" "$@" 2>&1)
  __VAL_RC=$?
}

# Create a temp git repo with the commit-msg hook wired up.
_new_repo() {
  local repo hook_dir
  repo=$(_tmpdir)
  hook_dir="$repo/hooks"
  (
    cd "$repo" || exit 1
    mkdir -p "$hook_dir"
    # Execute the configured hook by its real path. A symlinked individual
    # file would make BASH_SOURCE point at this fixture directory, separating
    # the hook from its sibling activation shim in a way production never does.
    cat >"$hook_dir/commit-msg" <<'EOF'
#!/usr/bin/env bash
exec "$DOT_TEST_COMMIT_MSG_HOOK" "$@"
EOF
    chmod +x "$hook_dir/commit-msg"
    export GIT_CONFIG_GLOBAL="$repo/.gitconfig-test"
    : >"$GIT_CONFIG_GLOBAL"
    git init -q
    _git_set_test_identity git
    git config core.hooksPath "$hook_dir"
    git config commit.gpgsign false
    # Seed with an initial commit so later commits don't fail on empty tree
    : >"$repo/.gitkeep"
    git add .gitkeep
    git commit -q -m "$(
      cat <<'EOF'
Initial commit

Summary
- seed repo

Testing
- n/a: scaffold
EOF
    )"
  )
  echo "$repo"
}

# Commit in a repo, capturing output. Like githook-test's _commit.
_commit() {
  local repo="$1" msg="$2"
  shift 2
  __COMMIT_OUT=$(
    cd "$repo" &&
      GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" "$@" \
        git commit -m "$msg" 2>&1
  )
  __COMMIT_RC=$?
}

# Put the real Sley message-validation operation behind a complete checkout
# fixture while making its independent secret gate deterministic. Production
# intentionally selects hooks and CLI from one root, so the test mirrors that
# dependency boundary instead of relying on ambient PATH order.
_mock_sley_message_root() {
  local mock_root
  mock_root=$(_tmpdir)
  mkdir -p "$mock_root/bin" "$mock_root/share/sley"
  ln -s "$DOT_SLEY_ROOT/share/sley/hooks" "$mock_root/share/sley/hooks"
  cat >"$mock_root/bin/sley" <<'EOF'
#!/usr/bin/env bash
if [ "${1:-}" = secrets ]; then
  exit 0
fi
exec "$SLEY_TEST_REAL_BIN" "$@"
EOF
  chmod +x "$mock_root/bin/sley"
  printf '%s\n' "$mock_root"
}

# Sley's executable-provider contract passes one opaque path. Prove the local
# policy adapter does not reinterpret an option-shaped filename as its legacy
# direct-CLI flags.
opaque_provider_dir=$(_tmpdir)
opaque_provider_title=$(printf '%0.s-' {1..101})
printf '%s\n' "$opaque_provider_title" >"$opaque_provider_dir/--strict"
__VAL_OUT=$(
  cd "$opaque_provider_dir" || exit 1
  "$SLEY_TEST_REAL_BIN" hook validate-message \
    --validator "$VALIDATOR" --message-file --strict 2>&1
)
__VAL_RC=$?
_assert_exit "provider path: option-shaped filename remains opaque" 1 "$__VAL_RC"
_assert_contains "provider path: option-shaped file receives normal policy" \
  "max 100" "$__VAL_OUT"

# ===========================================================================
# Validator: git format
# ===========================================================================

echo "=== Validator: valid git message ==="

_validate "$(
  cat <<'EOF'
Fix `ds -l` showing empty window count

Summary
- fix the count logic by checking window
  list length before display

Testing
- ran ds -l with no windows open
- ran ds -l with 3 windows, verified count
EOF
)" --format git
_assert_exit "valid git message: exit 0" 0 "$__VAL_RC"

echo "=== Validator: valid sl message ==="

valid_sl_message=$(
  cat <<'EOF'
Add `WidgetConfig` validation step

Summary:
Added validation for WidgetConfig parameters.

Test Plan:
buck2 test //tools/config:tests
https://ci.example.com/testrun/12345/

Differential Revision: REVISION_URL
EOF
)
valid_sl_revision=https://example.invalid/
valid_sl_revision+=D
valid_sl_revision+='12345678'
valid_sl_message=${valid_sl_message/REVISION_URL/$valid_sl_revision}
_validate "$valid_sl_message" --format sl
_assert_exit "valid sl message: exit 0" 0 "$__VAL_RC"

echo "=== Validator: Markdown section headings ==="

# The documented format uses plain headers. Markdown headings still satisfy
# the section lookup, so humans only see a warning, but strict mode (agents
# in owner repositories, Sapling agent commits) rejects them.
markdown_git_message=$(
  cat <<'EOF'
Fix the Git integration

## Summary

- preserve the existing behavior

## Testing

- ran the focused suite
EOF
)
_validate "$markdown_git_message" --format git --strict
_assert_exit "Markdown git headings (strict): blocked" 1 "$__VAL_RC"
_assert_contains "Markdown git headings (strict): Summary prefix named" \
  "'Summary' header must be plain text" "$__VAL_OUT"
_assert_contains "Markdown git headings (strict): Testing prefix named" \
  "'Testing' header must be plain text" "$__VAL_OUT"
_assert_not_contains "Markdown git headings (strict): sections still found" \
  "missing" "$__VAL_OUT"

_validate "$markdown_git_message" --format git
_assert_exit "Markdown git headings (non-strict): warn only" 0 "$__VAL_RC"
_assert_contains "Markdown git headings (non-strict): warning shown" \
  "'Summary' header must be plain text" "$__VAL_OUT"

_validate "$(
  cat <<'EOF'
Fix the Sapling integration

## Summary

- preserve the existing behavior

## Test Plan

- ran the focused suite
EOF
)" --format sl --strict
# Sapling messages back Phabricator Markdown, where headings are legitimate.
_assert_exit "Markdown sl headings (strict): exit 0" 0 "$__VAL_RC"
_assert_eq "Markdown sl headings (strict): no findings" "" "$__VAL_OUT"

# Format inference must recognize the rendered Test Plan heading too. Without
# this check, the validator can parse the heading but still choose Git policy
# and incorrectly require a Testing section.
_validate "$(
  cat <<'EOF'
Fix automatic format detection

## Summary

- recognize Markdown headings

## Test Plan

- ran the focused suite
EOF
)"
_assert_exit "Markdown Test Plan auto-detection: exit 0" 0 "$__VAL_RC"
_assert_not_contains "Markdown Test Plan auto-detection: no Testing required" \
  "missing 'Testing'" "$__VAL_OUT"

# A prose heading that merely starts with the same words is not the Sapling
# section. Keep Git format inference exact so unrelated notes cannot make a
# valid Git message fail for a missing Test Plan.
_validate "$(
  cat <<'EOF'
Fix automatic format detection

Summary

- keep section matching exact

Testing

- ran the focused suite

## Test Planning Notes

- no Sapling section is present
EOF
)" --strict
_assert_exit "Markdown Test Planning prose keeps Git format" 0 "$__VAL_RC"

echo "=== Validator: section layout ==="

_validate "$(printf 'Fix it\n\nTesting\n- ran it\n\nSummary\n- did it\n')" --format git --strict
_assert_exit "sections out of order (strict): blocked" 1 "$__VAL_RC"
_assert_contains "sections out of order: reported" \
  "'Summary' section must come before 'Testing'" "$__VAL_OUT"

_validate "$(printf 'Fix it\n\nTesting\n- ran it\n\nSummary\n- did it\n')" --format git
_assert_exit "sections out of order (non-strict): warn only" 0 "$__VAL_RC"

_validate "$(printf 'Fix it\n\nSummary\n- did it\nTesting\n- ran it\n')" --format git --strict
_assert_exit "no blank line before Testing (strict): blocked" 1 "$__VAL_RC"
_assert_contains "no blank line before Testing: reported" \
  "missing blank line before 'Testing' section" "$__VAL_OUT"

# Phabricator-style adjacent fields remain valid Sapling messages.
_validate "$(printf 'Fix it\n\nSummary: did it\nTest Plan: ran it\n')" --format sl --strict
_assert_exit "adjacent sl fields (strict): exit 0" 0 "$__VAL_RC"

_validate "$(printf 'Testing\n\nSummary\n- did it\n')" --format git --strict
_assert_exit "title named like a section does not satisfy it" 1 "$__VAL_RC"
_assert_contains "title named like a section: Testing still missing" \
  "missing 'Testing' section" "$__VAL_OUT"

# Wrapped prose may begin with a section word and a colon; only a column-0
# header (inline `Name: text` only after a blank line) is a section.
_validate "$(printf 'Fix it\n\nSummary\n\n- explain the change; the old harness\ntesting: was flaky, and the\nsummary: line was wrong\n\nTesting\n\n- ran it\n')" \
  --format git --strict
_assert_exit "prose starting with a section word: exit 0" 0 "$__VAL_RC"
_assert_eq "prose starting with a section word: no findings" "" "$__VAL_OUT"

_validate "$(printf 'Fix it\n\nSummary\n\n- did it\n\n## Testing\n\n- ran it\n')" --format git --strict
_assert_exit "git Markdown header after a blank line (strict): blocked" 1 "$__VAL_RC"

_validate "$(printf 'Fix it\n\nSummary: did it\n\n## Details\n\nTest Plan: ran it\n')" --format sl --strict
_assert_exit "sl Markdown subheading (strict): exit 0" 0 "$__VAL_RC"

# Markdown headings are headers wherever they sit, and an exactly spelled
# inline field after prose or another field is still a section.
for layout_case in \
  'Fix it\n\n  ## Summary\n\n- did it\n\n  ## Testing\n\n- ran it\n|header must be plain text' \
  'Fix it\n\nSummary\n\n- did it\n## Testing: ran it\n|header must be plain text' \
  'Fix it\n\nSummary: did things\nTesting: ran it\n|missing blank line before' \
  'Fix it\n\nTesting\n\nfoo\nSummary: x\n|must come before'; do
  _validate "$(printf '%b' "${layout_case%|*}")" --format git --strict
  _assert_exit "layout violation is caught: ${layout_case##*|}" 1 "$__VAL_RC"
  _assert_contains "layout violation is reported: ${layout_case##*|}" \
    "${layout_case##*|}" "$__VAL_OUT"
done

# shellcheck disable=SC2016 # literal Markdown fence.
_validate "$(printf 'Fix it\n\nSummary\n\n- quote:\n\n```\nfoo\nTesting\n```\n\nTesting\n\n- ran it\n')" \
  --format git --strict
_assert_exit "section word inside a code fence: exit 0" 0 "$__VAL_RC"
_assert_eq "section word inside a code fence: no findings" "" "$__VAL_OUT"

# A section quoted in a code fence does not stand in for the real one.
# shellcheck disable=SC2016 # literal Markdown fence.
_validate "$(printf 'Fix it\n\nSummary\n\n- quote:\n\n```\nTesting\n```\n')" --format git --strict
_assert_exit "section only inside a code fence (strict): blocked" 1 "$__VAL_RC"
_assert_contains "section only inside a code fence: reported missing" \
  "missing 'Testing' section" "$__VAL_OUT"

# shellcheck disable=SC2016 # literal Markdown fence.
_validate "$(printf 'Fix it\n\nSummary\n\n- did it\n\nTesting\n\n```\nmake test\n```\n')" --format git --strict
_assert_exit "section whose content is a code fence: exit 0" 0 "$__VAL_RC"

# An indented code block may quote a Markdown heading.
_validate "$(printf 'Fix it\n\nSummary\n\n- add a README section:\n\n    ## Testing\n\n    Run it.\n\nTesting\n\n- ran it\n')" \
  --format git --strict
_assert_exit "Markdown heading in an indented code block: exit 0" 0 "$__VAL_RC"
_assert_eq "Markdown heading in an indented code block: no findings" "" "$__VAL_OUT"

# Git drops leading blank lines, so the first non-blank line is the title.
_validate "$(printf '\n  \nFix it\n\nSummary\n\n- did it\n\nTesting\n\n- ran it\n')" --format git --strict
_assert_exit "leading blank lines before the title: exit 0" 0 "$__VAL_RC"

echo "=== Validator: body wrapping ==="

_wrap_message() {
  printf 'Fix it\n\nSummary\n\n%s\n\nTesting\n\n- ran it\n' "$1"
}
long_prose='- this sentence keeps going and going until it is well beyond the limits.'

very_long_prose='- this sentence keeps going and going and going until it is well beyond eighty cols'

# "~72": a line a few columns over warns even in strict mode; past 80 it is
# rejected.
_validate "$(_wrap_message "$long_prose")" --format git --strict
_assert_exit "73-column line (strict): warn only" 0 "$__VAL_RC"
_assert_contains "73-column line: line and width reported" \
  "line(s) 5 (73); consider wrapping" "$__VAL_OUT"

_validate "$(_wrap_message '- this sentence keeps going and going and going until it stops at column eighty.')" \
  --format git --strict
_assert_exit "80-column line (strict): warn only" 0 "$__VAL_RC"

_validate "$(_wrap_message "$very_long_prose")" --format git --strict
_assert_exit "81-column line (strict): blocked" 1 "$__VAL_RC"
_assert_contains "81-column line: hard limit reported" \
  "exceeds 80 columns on line(s) 5 (${#very_long_prose})" "$__VAL_OUT"

# shellcheck disable=SC2016 # literal Markdown code span.
_validate "$(_wrap_message '  everything passes except `native_doctor_term_reaps_every_parallel_extension`')" \
  --format git --strict
_assert_exit "code span straddling column 72 (strict): warn only" 0 "$__VAL_RC"
_assert_contains "code span straddling column 72: warned" "consider wrapping" "$__VAL_OUT"

_validate "$(_wrap_message "$long_prose")" --format git
_assert_exit "unwrapped line (non-strict): warn only" 0 "$__VAL_RC"
_assert_contains "unwrapped line (non-strict): warned" "exceeds 72 columns" "$__VAL_OUT"

# Sapling messages back Phabricator fields, whose paragraphs stay unwrapped.
_validate "$(printf 'Fix it\n\nSummary:\n%s\n\nTest Plan:\n- ran it\n' "$long_prose")" \
  --format sl --strict
_assert_exit "unwrapped line in sl format: allowed" 0 "$__VAL_RC"

_validate "$(_wrap_message "$(printf '%s\n' "$very_long_prose" "$very_long_prose" "$very_long_prose" "$very_long_prose")")" \
  --format git --strict
_assert_contains "many unwrapped lines: summarized" "and 1 more" "$__VAL_OUT"

_validate "$(_wrap_message "$(printf '%0.s—' {1..72})")" --format git --strict
_assert_exit "72 multibyte characters fit" 0 "$__VAL_RC"

# A whitespace-only overlong line must not crash on Bash 3.2's empty-array
# handling under `set -u`.
_validate "$(_wrap_message "$(printf -- '- did it\n  %s' "$(printf '%0.s ' {1..80})")")" \
  --format git --strict
_assert_exit "whitespace-only long line: no crash" 0 "$__VAL_RC"

# shellcheck disable=SC2016 # backticks are literal Markdown code spans.
for exempt in \
  '- see https://example.com/a/long/path/that/keeps/going/and/going/forever' \
  '    indented code that is long enough to pass the seventy-two column limit' \
  'Co-authored-by: Somebody With A Long Name <somebody.with.a.long.name@example.com>' \
  '- `home/.local/lib/dotfiles/some/really/long/path/to/a/deeply/nested/source.sh`' \
  "$(printf '```\n%s\n```' "$long_prose")"; do
  _validate "$(_wrap_message "$exempt")" --format git --strict
  _assert_exit "unwrappable line exempt: ${exempt:0:24}" 0 "$__VAL_RC"
done

echo "=== Validator: inline section content ==="

_validate "$(
  cat <<'EOF'
Fix something

Summary: Added the feature
Test Plan: buck2 test passed
EOF
)" --format sl --strict
_assert_exit "inline section content: exit 0" 0 "$__VAL_RC"

# ===========================================================================
# Validator: title checks
# ===========================================================================

echo "=== Validator: title checks ==="

_validate "$(printf '%0.s-' {1..101})" --format git
_assert_exit "title >100 chars: blocked" 1 "$__VAL_RC"
_assert_contains "title >100: reports length" "max 100" "$__VAL_OUT"

_validate "$(printf '%0.s-' {1..80})

Summary
- x

Testing
- x" --format git
_assert_exit "title 73-100 chars: warns but exits 0" 0 "$__VAL_RC"
_assert_contains "title 73-100: reports length" "prefer" "$__VAL_OUT"

_validate "Fix something.

Summary
- x

Testing
- x" --format git
