echo "=== Validator: COMMIT_MSG_SKIP ==="

# The skip path intentionally exits before reading stdin. Feed it without an
# upstream process so pipefail cannot turn that expected early exit into the
# writer's timing-dependent SIGPIPE status.
__VAL_OUT=$(COMMIT_MSG_SKIP=1 "$VALIDATOR" --strict <<<"bad" 2>&1)
__VAL_RC=$?
_assert_exit "COMMIT_MSG_SKIP: exit 0" 0 "$__VAL_RC"

echo "=== Validator: COMMIT_MSG_STRICT env ==="

__VAL_OUT=$(printf 'Fix something.\n' | COMMIT_MSG_STRICT=1 "$VALIDATOR" --format git 2>&1)
__VAL_RC=$?
_assert_exit "COMMIT_MSG_STRICT env: blocked" 1 "$__VAL_RC"

# ===========================================================================
# Validator: --file mode
# ===========================================================================

echo "=== Validator: --file mode ==="

tmpf=$(_tmpdir)/msg.txt
cat >"$tmpf" <<'EOF'
Fix `something` in the codebase

# This is a git comment line
# Another comment

Summary
- fixed the thing

Testing
- ran the test
EOF

__VAL_OUT=$("$VALIDATOR" --format git --file "$tmpf" 2>&1)
__VAL_RC=$?
_assert_exit "--file mode: strips comments, exit 0" 0 "$__VAL_RC"

# The commit-msg hook uses --file. Git's default comment marker is also `#`,
# so comment removal must distinguish real one-marker template lines from the
# Markdown headings used by this repository's commit convention.
