#!/usr/bin/env bash
# Verify dotfiles' activation and policy boundary around Sley's Git hooks.
#
# Sley owns generic readiness, sequencer detection, commit-message dispatch,
# and secret scanning, all of which are covered in Sley's commit-hooks suite.
# Dotfiles owns the global Git activation path, consistent provider selection,
# its commit-message validator choice, and one base-client HOME optimization.
# Keeping this suite on those responsibilities prevents the reusable behavior
# from accumulating a second, slower integration suite here.

set -o pipefail
export NO_COLOR=1

# shellcheck source=dev/helpers.sh
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

# Read the hooks from the checkout under test, whether or not it is linked
# into HOME; every file this suite activates is owned by this overlay.
SOURCE_HOME="$(_dev_repo_root)/home"

# The hooks call Git only to recognize the base client layout. Use an
# ordinary Git binary so that test fixtures do not recurse through the
# dotfiles-aware launcher that is covered by the core launcher suite.
_test_prefer_system_git

HOOK_DIR=$(HOME="$SOURCE_HOME" git config \
  --file "$SOURCE_HOME/.config/git/config" --path --get core.hooksPath)
HOOK_DIR_REAL=$(_test_realpath "$HOOK_DIR")

for hook in \
  pre-commit pre-merge-commit pre-applypatch prepare-commit-msg commit-msg \
  sley-commit-gate sley-provider-hook; do
  if [[ -x "$HOOK_DIR/$hook" ]]; then
    _pass "configured Git hook is executable: $hook"
  else
    _fail "configured Git hook is executable: $hook"
  fi
done

# Build a provider fixture that records the exact boundary dotfiles presents
# to Sley. The fixture deliberately invokes `sley` by name, matching the real
# provider hooks, so the test also proves that DOT_SLEY_ROOT binds the hook and
# CLI to one checkout rather than mixing versions through ambient PATH.
_mock_sley_root() {
  local root="$1" hook
  mkdir -p "$root/bin" "$root/share/sley/hooks/git"

  cat >"$root/bin/sley" <<'EOF'
#!/usr/bin/env bash
printf 'cli' >>"$SLEY_CLI_LOG"
printf ' <%s>' "$@" >>"$SLEY_CLI_LOG"
printf '\n' >>"$SLEY_CLI_LOG"
EOF
  chmod +x "$root/bin/sley"

  for hook in \
    pre-commit pre-merge-commit pre-applypatch prepare-commit-msg commit-msg \
    sley-commit-gate; do
    cat >"$root/share/sley/hooks/git/$hook" <<'EOF'
#!/usr/bin/env bash
{
  printf 'hook=%s\n' "${0##*/}"
  printf 'gate=%s\n' "${SLEY_GIT_COMMIT_GATE:-}"
  printf 'validator=%s\n' "${SLEY_COMMIT_MESSAGE_VALIDATOR:-}"
  printf 'template=%s\n' "${SLEY_COMMIT_MESSAGE_TEMPLATE:-}"
  printf 'format=%s\n' "${COMMIT_MSG_FORMAT:-}"
  printf 'strict=%s\n' "${COMMIT_MSG_STRICT:-}"
  printf 'skip-untracked=%s\n' "${SLEY_SKIP_UNTRACKED:-}"
  printf 'args'
  printf ' <%s>' "$@"
  printf '\n'
} >>"$SLEY_PROVIDER_LOG"
sley "from-${0##*/}" "$@"
EOF
    chmod +x "$root/share/sley/hooks/git/$hook"
  done
}

test_root=$(_tmpdir)
canonical_root="$test_root/canonical-root"
mkdir -p "$canonical_root/real"
touch "$canonical_root/real/file"
ln -s "$canonical_root/real" "$canonical_root/alias"
canonical_real=$(cd -P -- "$canonical_root/real" && pwd -P)
_assert_eq "path helper canonicalizes through a symlink without realpath" \
  "$canonical_real/file" \
  "$(PATH='' _test_realpath "$canonical_root/alias/file")"

provider_root="$test_root/provider"
provider_log="$test_root/provider.log"
cli_log="$test_root/cli.log"
shadow_bin="$test_root/shadow-bin"
shadow_log="$test_root/shadow.log"
mkdir -p "$shadow_bin"
_mock_sley_root "$provider_root"
: >"$provider_log"
: >"$cli_log"
: >"$shadow_log"

cat >"$shadow_bin/sley" <<'EOF'
#!/usr/bin/env bash
printf 'shadow\n' >>"$SLEY_SHADOW_LOG"
exit 9
EOF
chmod +x "$shadow_bin/sley"

export SLEY_PROVIDER_LOG="$provider_log"
export SLEY_CLI_LOG="$cli_log"
export SLEY_SHADOW_LOG="$shadow_log"

echo "=== Sley provider activation ==="

activation_output="$test_root/activation.out"
missing_root="$test_root/missing"
mkdir -p "$missing_root"
DOT_SLEY_ROOT="$missing_root" \
  "$HOOK_DIR/sley-provider-hook" pre-commit >"$activation_output" 2>&1
activation_rc=$?
_assert_exit "provider activation: missing hook fails closed" 1 "$activation_rc"
_assert_contains "provider activation: missing hook explains dot update recovery" \
  "run dot update" "$(cat "$activation_output")"

"$HOOK_DIR/sley-provider-hook" unsupported-hook >"$activation_output" 2>&1
activation_rc=$?
_assert_exit "provider activation: unknown hook is rejected" 1 "$activation_rc"
_assert_contains "provider activation: unknown hook is named" \
  "unsupported Sley hook: unsupported-hook" "$(cat "$activation_output")"

missing_cli_root="$test_root/missing-cli"
mkdir -p "$missing_cli_root/share/sley/hooks/git"
cp "$provider_root/share/sley/hooks/git/pre-commit" \
  "$missing_cli_root/share/sley/hooks/git/pre-commit"
DOT_SLEY_ROOT="$missing_cli_root" \
  "$HOOK_DIR/sley-provider-hook" pre-commit >"$activation_output" 2>&1
activation_rc=$?
_assert_exit "provider activation: missing matching CLI fails closed" 1 "$activation_rc"
_assert_contains "provider activation: missing CLI explains dot update recovery" \
  "Sley CLI is missing or not executable" "$(cat "$activation_output")"

: >"$provider_log"
: >"$cli_log"
DOT_SLEY_ROOT="$provider_root" \
  PATH="$shadow_bin:$PATH" \
  "$HOOK_DIR/sley-provider-hook" pre-commit
activation_rc=$?
_assert_exit "provider activation: selected checkout succeeds" 0 "$activation_rc"
_assert_file_content "provider activation: matching checkout CLI wins PATH" \
  "cli <from-pre-commit>" "$cli_log"
_assert_file_content "provider activation: ambient CLI is not mixed in" \
  "" "$shadow_log"
_assert_contains "provider activation: injects the dotfiles policy gate" \
  "gate=$HOOK_DIR_REAL/sley-commit-gate" "$(cat "$provider_log")"

# Without the override the hook must find Sley only through shdeps (via the
# base dep-file helper), never through a spelled install path. The fixture
# HOME models that helper over a stub resolver that serves the provider from
# a root outside shdeps' default layout.
resolver_home="$test_root/resolver-home"
resolver_bin="$test_root/resolver-bin"
mkdir -p "$resolver_home/.local/lib/dotfiles" "$resolver_bin"
cat >"$resolver_home/.local/lib/dotfiles/shdeps-assets.sh" <<'EOF'
dot_shdeps_dep_file() {
  shdeps dep-file "$@"
}
EOF
cat >"$resolver_bin/shdeps" <<'EOF'
#!/usr/bin/env bash
[[ $1 == dep-file && $2 == cgraf78/sley && -f $SLEY_TEST_DEP_ROOT/$3 ]] || exit 1
printf '%s/%s\n' "$SLEY_TEST_DEP_ROOT" "$3"
EOF
chmod +x "$resolver_bin/shdeps"

: >"$provider_log"
: >"$cli_log"
env -u DOT_SLEY_ROOT HOME="$resolver_home" SLEY_TEST_DEP_ROOT="$provider_root" \
  PATH="$resolver_bin:$shadow_bin:$PATH" \
  "$HOOK_DIR/sley-provider-hook" pre-commit
activation_rc=$?
_assert_exit "provider activation: shdeps-resolved checkout succeeds" 0 "$activation_rc"
_assert_file_content "provider activation: resolved root supplies the CLI" \
  "cli <from-pre-commit>" "$cli_log"
_assert_contains "provider activation: resolved root supplies the hook" \
  "hook=pre-commit" "$(cat "$provider_log")"

env -u DOT_SLEY_ROOT HOME="$resolver_home" SLEY_TEST_DEP_ROOT="$missing_root" \
  PATH="$resolver_bin:$PATH" \
  "$HOOK_DIR/sley-provider-hook" pre-commit >"$activation_output" 2>&1
activation_rc=$?
_assert_exit "provider activation: unresolvable Sley fails closed" 1 "$activation_rc"
_assert_contains "provider activation: unresolvable Sley names the dependency" \
  "shdeps cannot resolve the Sley CLI (cgraf78/sley bin/sley)" "$(cat "$activation_output")"
_assert_contains "provider activation: unresolvable Sley explains recovery" \
  "run dot update" "$(cat "$activation_output")"

env -u DOT_SLEY_ROOT HOME="$test_root/no-helper-home" \
  "$HOOK_DIR/sley-provider-hook" pre-commit >"$activation_output" 2>&1
activation_rc=$?
_assert_exit "provider activation: missing resolver helper fails closed" 1 "$activation_rc"
_assert_contains "provider activation: missing resolver helper explains recovery" \
  "shdeps cannot resolve the Sley CLI" "$(cat "$activation_output")"

echo
echo "=== Git hook activation shims ==="

_assert_hook_dispatch() {
  local description="$1" wrapper="$2" expected_hook="$3" expected_args="$4"
  shift 4
  : >"$provider_log"
  : >"$cli_log"
  DOT_SLEY_ROOT="$provider_root" "$HOOK_DIR/$wrapper" "$@"
  _assert_contains "$description selects the provider hook" \
    "hook=$expected_hook" "$(cat "$provider_log")"
  _assert_contains "$description preserves the provider arguments" \
    "args$expected_args" "$(cat "$provider_log")"
  _assert_file_content "$description uses the matching provider CLI" \
    "cli <from-$expected_hook>$expected_args" "$cli_log"
}

_assert_hook_dispatch "pre-commit" pre-commit pre-commit ""
_assert_hook_dispatch "pre-merge-commit" pre-merge-commit pre-merge-commit ""
_assert_hook_dispatch "pre-applypatch" pre-applypatch pre-applypatch ""
message_file="$test_root/message with spaces"
printf 'message\n' >"$message_file"
_assert_hook_dispatch "prepare-commit-msg" prepare-commit-msg prepare-commit-msg \
  " <$message_file> <merge> <abc123>" "$message_file" merge abc123

echo
echo "=== Base client repository policy ==="

# A normal invocation must remain a pure Sley delegation. Only the unusual
# base dotfiles shape is allowed to suppress Sley's untracked HOME walk.
: >"$provider_log"
: >"$cli_log"
env -u GIT_DIR -u GIT_WORK_TREE -u SLEY_SKIP_UNTRACKED \
  DOT_SLEY_ROOT="$provider_root" \
  "$HOOK_DIR/sley-commit-gate"
_assert_contains "ordinary gate leaves Sley's untracked scan enabled" \
  "skip-untracked=" "$(cat "$provider_log")"

fixture_home="$test_root/home"
bare_repo="$fixture_home/.dotfiles"
mkdir -p "$fixture_home"
git init -q --bare "$bare_repo"
: >"$provider_log"
: >"$cli_log"
env -u SLEY_SKIP_UNTRACKED \
  HOME="$fixture_home" \
  GIT_DIR="$bare_repo" \
  GIT_WORK_TREE="$fixture_home" \
  DOT_SLEY_ROOT="$provider_root" \
  "$HOOK_DIR/sley-commit-gate"
_assert_contains "legacy bare HOME gate disables only the untracked walk" \
  "skip-untracked=1" "$(cat "$provider_log")"
_assert_file_content "legacy bare HOME gate still delegates to Sley" \
  "cli <from-sley-commit-gate>" "$cli_log"

other_bare="$fixture_home/.other-bare"
git init -q --bare "$other_bare"
: >"$provider_log"
env -u SLEY_SKIP_UNTRACKED \
  HOME="$fixture_home" \
  GIT_DIR="$other_bare" \
  GIT_WORK_TREE="$fixture_home" \
  DOT_SLEY_ROOT="$provider_root" \
  "$HOOK_DIR/sley-commit-gate"
_assert_contains "other bare repositories do not inherit dotfiles policy" \
  "skip-untracked=" "$(cat "$provider_log")"
_assert_not_contains "other bare repositories do not skip untracked files" \
  "skip-untracked=1" "$(cat "$provider_log")"

echo
echo "=== Commit-message policy selection ==="

default_validator=$SOURCE_HOME/.local/lib/dotfiles/sley-hooks/validate-commit-msg
: >"$provider_log"
: >"$cli_log"
SLEY_COMMIT_MESSAGE_TEMPLATE="ambient-template" \
  SLEY_COMMIT_MESSAGE_VALIDATOR="ambient-validator" \
  DOT_SLEY_ROOT="$provider_root" \
  "$HOOK_DIR/commit-msg" "$message_file"
commit_rc=$?
_assert_exit "commit-msg activation succeeds" 0 "$commit_rc"
actual_validator=$(sed -n 's/^validator=//p' "$provider_log")
_assert_eq "commit-msg selects dotfiles' advanced validator" \
  "$(_test_realpath "$default_validator")" "$(_test_realpath "$actual_validator")"
_assert_contains "commit-msg identifies the Git message profile" \
  "format=git" "$(cat "$provider_log")"
_assert_contains "commit-msg forwards the message path unchanged" \
  "args <$message_file>" "$(cat "$provider_log")"
_assert_contains "commit-msg clears an ambient template provider" \
  "template=" "$(cat "$provider_log")"
_assert_not_contains "commit-msg does not retain the ambient template" \
  "template=ambient-template" "$(cat "$provider_log")"

custom_validator="$test_root/custom-validator"
printf '#!/usr/bin/env bash\n' >"$custom_validator"
chmod +x "$custom_validator"
: >"$provider_log"
DOT_COMMIT_MSG_VALIDATOR="$custom_validator" \
  DOT_SLEY_ROOT="$provider_root" \
  "$HOOK_DIR/commit-msg" "$message_file"
_assert_contains "commit-msg supports an explicit dotfiles validator checkout" \
  "validator=$custom_validator" "$(cat "$provider_log")"

: >"$provider_log"
missing_validator="$test_root/missing-validator"
DOT_COMMIT_MSG_VALIDATOR="$missing_validator" \
  DOT_SLEY_ROOT="$provider_root" \
  "$HOOK_DIR/commit-msg" "$message_file" >"$activation_output" 2>&1
commit_rc=$?
_assert_exit "missing dotfiles validator remains advisory" 0 "$commit_rc"
_assert_contains "missing validator warning names the skipped provider" \
  "dotfiles message validator is not executable: $missing_validator" \
  "$(cat "$activation_output")"
_assert_contains "missing validator still dispatches Sley's generic hook" \
  "hook=commit-msg" "$(cat "$provider_log")"
_assert_contains "missing validator does not select a stale provider" \
  "validator=" "$(cat "$provider_log")"

echo
echo "=== Agent commit-message policy ==="

# The hooks ask AgentGuard (through the base shdeps helper) whether an agent is
# driving. A fixture HOME supplies a stand-in API controlled by
# TEST_AGENT_SESSION so these cases are independent of whichever agent or
# human runs the suite.
agent_home="$test_root/agent-home"
mkdir -p "$agent_home/.local/lib/dotfiles"
cat >"$agent_home/agentguard.sh" <<'EOF'
agentguard_is_session() { [ "${TEST_AGENT_SESSION:-0}" = 1 ]; }
EOF
cat >"$agent_home/.local/lib/dotfiles/shdeps-assets.sh" <<'EOF'
dot_shdeps_dep_source() {
  [ "$1" = cgraf78/agentguard ] && [ "$2" = lib/agentguard/agentguard.sh ] || return 1
  . "$HOME/agentguard.sh"
}
EOF

# _policy_repo NAME [ORIGIN_URL]: an empty repository with an optional origin.
_policy_repo() {
  local repo="$test_root/repos/$1"
  git init -q "$repo"
  [[ -z ${2:-} ]] || git -C "$repo" remote add origin "$2"
  printf '%s\n' "$repo"
}

owned_repo=$(_policy_repo owned https://github.com/cgraf78/example.git)
alias_repo=$(_policy_repo alias github-dotfiles-work:cgraf78/dotfiles-work.git)
upper_repo=$(_policy_repo upper git@github.com:CGraf78/Example.git)
third_repo=$(_policy_repo third https://github.com/neovim/neovim.git)
lookalike_repo=$(_policy_repo lookalike https://github.com/cgraf78x/example.git)
no_origin_repo=$(_policy_repo no-origin)

# _run_commit_msg REPO AGENT [ENV...]: run commit-msg from REPO with the
# fixture AgentGuard; sets commit_rc and commit_err.
_run_commit_msg() {
  local repo="$1" agent="$2"
  shift 2
  : >"$provider_log"
  : >"$cli_log"
  commit_err=$(
    cd "$repo" &&
      env -u COMMIT_MSG_STRICT -u COMMIT_MSG_SKIP -u GITHOOK_COMMITMSG_SKIP \
        HOME="$agent_home" TEST_AGENT_SESSION="$agent" \
        DOT_SLEY_ROOT="$provider_root" "$@" \
        "$HOOK_DIR/commit-msg" "$message_file" 2>&1 >/dev/null
  )
  commit_rc=$?
}

_run_commit_msg "$owned_repo" 1
_assert_exit "agent in owner repo: activation succeeds" 0 "$commit_rc"
_assert_contains "agent in owner repo: strict policy forced" \
  "strict=1" "$(cat "$provider_log")"

_run_commit_msg "$owned_repo" 1 COMMIT_MSG_STRICT=0
_assert_contains "agent in owner repo: COMMIT_MSG_STRICT=0 cannot relax policy" \
  "strict=1" "$(cat "$provider_log")"

for repo in "$alias_repo" "$upper_repo"; do
  _run_commit_msg "$repo" 1
  _assert_contains "agent in owner repo: strict via $(git -C "$repo" remote get-url origin)" \
    "strict=1" "$(cat "$provider_log")"
done

_run_commit_msg "$owned_repo" 0
_assert_exit "human in owner repo: activation succeeds" 0 "$commit_rc"
_assert_contains "human in owner repo: advisory policy kept" \
  "strict=" "$(cat "$provider_log")"
_assert_not_contains "human in owner repo: strict not forced" \
  "strict=1" "$(cat "$provider_log")"

_run_commit_msg "$owned_repo" 0 COMMIT_MSG_STRICT=1
_assert_contains "human in owner repo: explicit COMMIT_MSG_STRICT=1 honored" \
  "strict=1" "$(cat "$provider_log")"

fork_msg_repo=$(_policy_repo fork-msg https://github.com/cgraf78/aravis.git)
git -C "$fork_msg_repo" remote add upstream https://github.com/AravisProject/aravis.git
for repo in "$third_repo" "$lookalike_repo" "$no_origin_repo" "$fork_msg_repo"; do
  _run_commit_msg "$repo" 1
  _assert_exit "agent in third-party repo ${repo##*/}: activation succeeds" 0 "$commit_rc"
  _assert_not_contains "agent in third-party repo ${repo##*/}: advisory policy kept" \
    "strict=1" "$(cat "$provider_log")"
done

for knob in GITHOOK_COMMITMSG_SKIP COMMIT_MSG_SKIP; do
  for repo in "$owned_repo" "$third_repo"; do
    _run_commit_msg "$repo" 1 "$knob=1"
    _assert_exit "agent $knob in ${repo##*/} repo: refused" 1 "$commit_rc"
    _assert_contains "agent $knob in ${repo##*/} repo: names the refused knob" \
      "not allowed in agent sessions" "$commit_err"
    _assert_file_content "agent $knob in ${repo##*/} repo: provider not reached" \
      "" "$provider_log"
  done
done

_run_commit_msg "$owned_repo" 0 GITHOOK_COMMITMSG_SKIP=1
_assert_exit "human GITHOOK_COMMITMSG_SKIP: exit 0" 0 "$commit_rc"
_assert_file_content "commit-msg skip bypasses provider activation" \
  "" "$provider_log"
_assert_file_content "commit-msg skip bypasses the provider CLI" \
  "" "$cli_log"

# COMMIT_MSG_SKIP only skips structure: the hook still dispatches so Sley's
# independent secret scan runs.
_run_commit_msg "$owned_repo" 0 COMMIT_MSG_SKIP=1
_assert_exit "human COMMIT_MSG_SKIP: exit 0" 0 "$commit_rc"
_assert_contains "human COMMIT_MSG_SKIP: provider still dispatched" \
  "hook=commit-msg" "$(cat "$provider_log")"

# A broken AgentGuard install degrades to the human policy with a warning.
: >"$provider_log"
commit_err=$(
  cd "$owned_repo" &&
    env -u COMMIT_MSG_STRICT HOME="$test_root/no-helper-home" \
      DOT_SLEY_ROOT="$provider_root" \
      "$HOOK_DIR/commit-msg" "$message_file" 2>&1 >/dev/null
)
commit_rc=$?
_assert_exit "missing AgentGuard: commit-msg still succeeds" 0 "$commit_rc"
_assert_contains "missing AgentGuard: warning names the dependency" \
  "AgentGuard is unavailable" "$commit_err"
_assert_not_contains "missing AgentGuard: advisory policy kept" \
  "strict=1" "$(cat "$provider_log")"

echo
echo "=== Remote ownership parsing ==="

# shellcheck source=../git-hooks/policy.sh
. "$HOOK_DIR/policy.sh"
while IFS='|' read -r url expected; do
  actual=$(_githook_remote_repo "$url") || actual='<none>'
  _assert_eq "remote repo of '$url'" "$expected" "$actual"
done <<'EOF'
https://github.com/cgraf78/dotfiles.git|cgraf78/dotfiles
https://github.com/cgraf78/dotfiles|cgraf78/dotfiles
https://github.com/cgraf78/dotfiles/|cgraf78/dotfiles
ssh://git@github.com/cgraf78/shdeps.git|cgraf78/shdeps
ssh://git@github.com:22/cgraf78/shdeps.git|cgraf78/shdeps
git@github.com:CGraf78/Sley.git|cgraf78/sley
github-dotfiles-work:cgraf78/dotfiles-work.git|cgraf78/dotfiles-work
https://gitlab.example.com/group/sub/project.git|<none>
/tmp/cgraf78/remote.git|<none>
./cgraf78/remote.git|<none>
../remote.git|<none>
file:///tmp/cgraf78/remote.git|<none>
dir/cgraf78:remote.git|<none>
https://github.com|<none>
|<none>
git@github.com:/cgraf78/x.git|cgraf78/x
ssh://git@github.com//cgraf78/x|cgraf78/x
https://github.com//cgraf78/x.git|cgraf78/x
https://github.com/cgraf78//x.git//|cgraf78/x
https://github.com/cgraf78/./zz|cgraf78/zz
https://github.com/x/../cgraf78/zz|cgraf78/zz
https://github.com/../cgraf78/zz|cgraf78/zz
EOF

echo
echo "=== AgentGuard detection contract ==="

# The policy relies on AgentGuard seeing agent identity in the environment
# Git hooks inherit from agent tool shells. Check the real API when the host
# has it: Claude exports CLAUDE_CODE_SESSION_ID, Codex AGENT=codex (plus
# CODEX_THREAD_ID), and Muse AGENT=muse to their tool subprocesses.
host_assets="${DOT_TEST_HOST_HOME:-$HOME}/.local/lib/dotfiles/shdeps-assets.sh"
real_api=''
if [[ -r $host_assets ]]; then
  real_api=$(
    # shellcheck source=/dev/null # host-installed base helper.
    . "$host_assets" 2>/dev/null &&
      dot_shdeps_dep_file cgraf78/agentguard lib/agentguard/agentguard.sh 2>/dev/null
  ) || real_api=''
fi
if [[ -z $real_api || ! -r $real_api ]]; then
  echo "  SKIP: AgentGuard is not installed on this host"
else
  _detect() {
    # shellcheck disable=SC2016 # expanded by the child shell.
    env -i PATH="$PATH" HOME="$HOME" AGENTGUARD_PROCESS_DETECT=0 "$@" \
      bash -c '. "$1"; agentguard_is_session' _ "$real_api"
  }
  _detect CLAUDE_CODE_SESSION_ID=s
  _assert_exit "AgentGuard detects Claude tool shells" 0 "$?"
  _detect AGENT=codex
  _assert_exit "AgentGuard detects Codex tool shells" 0 "$?"
  _detect AGENT=muse MUSE_SESSION_ID=s
  _assert_exit "AgentGuard detects Muse tool shells" 0 "$?"
  _detect
  _assert_exit "AgentGuard reports a plain human shell" 1 "$?"
fi

_test_summary
