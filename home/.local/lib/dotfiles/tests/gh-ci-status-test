#!/usr/bin/env bash
# gh-ci-status-test - owner-wide GitHub CI summary.
#
# A stub gh serves pre-rendered record fixtures, so the suite runs without
# network or jq. The stub also captures the jq programs the command hands to
# gh; where jq exists, they are replayed over equivalent GitHub JSON fixtures
# to prove they render exactly the records the fixtures assume.

set -o pipefail
export NO_COLOR=1
# jq 1.6's fromdateiso8601 applies the local zone's DST offset to UTC
# timestamps, which would shift the replayed epochs on some hosts; gh's
# embedded gojq does not, so pinning UTC only keeps the replay deterministic.
export TZ=UTC

# shellcheck source=dev/helpers.sh
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

command_path="$(_dev_repo_root)/home/.local/bin/gh-ci-status"
fixtures=$(_tmpdir)
stub_bin=$(_mock_bin)
gh_log="$fixtures/gh.log"
jq_capture="$fixtures/records.jq"
sched_jq_capture="$fixtures/sched.jq"
workflows_jq_capture="$fixtures/workflows.jq"
required_jq_capture="$fixtures/required.jq"
checks_jq_capture="$fixtures/checks.jq"
statuses_jq_capture="$fixtures/statuses.jq"
credit_jq_capture="$fixtures/credit.jq"
sched_dir="$fixtures/sched"
mkdir -p "$sched_dir"

# One call counter drives --watch: call N serves records.N when present and
# falls back to records, so a sequence of fixtures models checks settling.
# A records.N.fail marker makes call N fail like a transient API error.
# Scheduled runs come from $GH_STUB_SCHED_DIR: <repo>.workflows holds the
# active workflow ids (a missing file means none) and <repo>.workflows.fail
# fails that call. <repo>.<id> is workflow <id>'s newest run record; per-call
# files <repo>.<id>.<N> and <repo>.<id>.<N>.fail override the Nth read of it,
# so --watch can see a run settle or a re-read fail. A <repo>.<id>.json file
# instead holds a raw GitHub runs listing that the stub pipes through the
# command's own jq program, as gh does, so run selection is exercised end to
# end; those cases need jq, and only the .<N>.fail per-call override applies
# to them. A GraphQL call naming a repository is the merged pull request
# credit lookup: it serves <repo>.credit (a rendered number/state record;
# missing means no pull request qualifies), fails on <repo>.credit.fail, and
# per-call <repo>.credit.<N> and <repo>.credit.<N>.fail override the Nth read.
cat >"$stub_bin/gh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$GH_STUB_LOG"
# Print the value of the --jq argument among "$@", if any.
jq_program() {
  while (($#)); do
    if [[ $1 == --jq ]]; then
      printf '%s' "$2"
      return
    fi
    shift
  done
}
if [[ $1 == api && $2 == -X && $3 == GET ]]; then
  path=$4
  [[ $path != --paginate ]] || path=$5
  repo=${path#repos/*/}
  repo=${repo%%/*}
  dir=$GH_STUB_SCHED_DIR
  case $path in
    */actions/workflows)
      jq_program "$@" >"$GH_STUB_WORKFLOWS_JQ_CAPTURE"
      [[ ! -f $dir/$repo.workflows.fail ]] || exit 1
      cat "$dir/$repo.workflows" 2>/dev/null
      exit 0
      ;;
    */actions/workflows/*/runs)
      jq_program "$@" >"$GH_STUB_SCHED_JQ_CAPTURE"
      id=${path%/runs}
      id=${id##*/}
      counter=$dir/$repo.$id.count
      count=$(($(cat "$counter" 2>/dev/null || echo 0) + 1))
      printf '%s\n' "$count" >"$counter"
      [[ ! -f $dir/$repo.$id.$count.fail ]] || exit 1
      if [[ -f $dir/$repo.$id.json ]]; then
        jq -r "$(jq_program "$@")" "$dir/$repo.$id.json"
        exit
      fi
      if [[ -f $dir/$repo.$id.$count ]]; then
        cat "$dir/$repo.$id.$count"
      else
        cat "$dir/$repo.$id" 2>/dev/null
      fi
      exit 0
      ;;
    */branches/*)
      jq_program "$@" >"$GH_STUB_REQUIRED_JQ_CAPTURE"
      [[ ! -f $dir/$repo.required.fail ]] || exit 1
      if [[ -f $dir/$repo.required ]]; then
        IFS= read -r first <"$dir/$repo.required" || first=
        if [[ $first != meta$'\x1f'* ]]; then
          printf 'meta\037true\n'
          while IFS= read -r line; do
            printf 'required\037%s\n' "$line"
          done <"$dir/$repo.required"
        else
          cat "$dir/$repo.required"
        fi
      else
        printf 'meta\037false\n'
      fi
      exit 0
      ;;
    */commits/*/check-runs)
      jq_program "$@" >"$GH_STUB_CHECKS_JQ_CAPTURE"
      [[ ! -f $dir/$repo.checks.fail ]] || exit 1
      counter=$dir/$repo.checks.count
      count=$(($(cat "$counter" 2>/dev/null || echo 0) + 1))
      printf '%s\n' "$count" >"$counter"
      [[ ! -f $dir/$repo.checks.$count.fail ]] || exit 1
      [[ $count -le 1 || ! -f $dir/$repo.checks.after-first.fail ]] || exit 1
      if [[ -f $dir/$repo.checks.$count ]]; then
        cat "$dir/$repo.checks.$count"
      else
        cat "$dir/$repo.checks" 2>/dev/null
      fi
      exit 0
      ;;
    */commits/*/statuses)
      jq_program "$@" >"$GH_STUB_STATUSES_JQ_CAPTURE"
      [[ ! -f $dir/$repo.statuses.fail ]] || exit 1
      cat "$dir/$repo.statuses" 2>/dev/null
      exit 0
      ;;
  esac
  exit 2
fi
if [[ $1 == api && $2 == user ]]; then
  [[ -z ${GH_STUB_USER_FAIL:-} ]] || exit 1
  printf '%s\n' "${GH_STUB_USER:-stub-user}"
  exit 0
fi
if [[ $1 == api && $2 == graphql && " $* " == *" -f repo="* ]]; then
  repo=" $* "
  repo=${repo#* -f repo=}
  repo=${repo%% *}
  dir=$GH_STUB_SCHED_DIR
  jq_program "$@" >"$GH_STUB_CREDIT_JQ_CAPTURE"
  [[ ! -f $dir/$repo.credit.fail ]] || exit 1
  counter=$dir/$repo.credit.count
  count=$(($(cat "$counter" 2>/dev/null || echo 0) + 1))
  printf '%s\n' "$count" >"$counter"
  [[ ! -f $dir/$repo.credit.$count.fail ]] || exit 1
  if [[ -f $dir/$repo.credit.$count ]]; then
    cat "$dir/$repo.credit.$count"
  else
    cat "$dir/$repo.credit" 2>/dev/null
  fi
  exit 0
fi
if [[ $1 == api && $2 == graphql ]]; then
  [[ -z ${GH_STUB_GRAPHQL_FAIL:-} ]] || exit 1
  # Model the upstream timeout for a repository page larger than ten while
  # preserving gh's contract of returning every page with --paginate.
  if [[ -n ${GH_STUB_BOUNDED_PAGES:-} ]]; then
    query=
    paginate=0
    args=("$@")
    for arg in "${args[@]}"; do
      [[ $arg != --paginate ]] || paginate=1
      [[ $arg != query=* ]] || query=${arg#query=}
    done
    [[ $query =~ repositories\(first:[[:space:]]*([0-9]+) ]] || exit 2
    ((BASH_REMATCH[1] <= 10)) || exit 1
    cat "$GH_STUB_RECORDS"
    ((paginate == 0)) || cat "$GH_STUB_RECORDS.page2"
    exit 0
  fi
  while (($#)); do
    if [[ $1 == --jq ]]; then
      printf '%s' "$2" >"$GH_STUB_JQ_CAPTURE"
      break
    fi
    shift
  done
  count=$(($(cat "$GH_STUB_COUNTER" 2>/dev/null || echo 0) + 1))
  printf '%s\n' "$count" >"$GH_STUB_COUNTER"
  [[ ! -f $GH_STUB_RECORDS.$count.fail ]] || exit 1
  if [[ -f $GH_STUB_RECORDS.$count ]]; then
    cat "$GH_STUB_RECORDS.$count"
  else
    cat "$GH_STUB_RECORDS"
  fi
  exit 0
fi
exit 2
SH
chmod +x "$stub_bin/gh"

tab=$'\t'
us=$'\x1f'
# Print the arguments as one record joined with the unit separator, matching
# the lines the command's jq program emits.
_rec() {
  local IFS=$us
  printf '%s\n' "$*"
}

records="$fixtures/records"
{
  _rec repo alpha main aaaaaaa1111111111111111111111111111111 SUCCESS
  _rec pr alpha 1 FAILURE false true https://github.test/o/alpha/pull/1 'Fix alpha'
  _rec pr alpha 4 '' true true https://github.test/o/alpha/pull/4 'No checks yet'
  _rec repo beta main ccccccc3333333333333333333333333333333 PENDING
  _rec repo delta main ddddddd4444444444444444444444444444444 SUCCESS
  _rec pr delta 2 SUCCESS true false https://github.test/o/delta/pull/2 'Draft delta'
  _rec truncated delta 31
  _rec repo empty '' '' ''
  _rec repo epsilon main 7777777777777777777777777777777777777777 ERROR
  _rec repo fail main 8888888888888888888888888888888888888888 SUCCESS
  _rec repo gamma main fffffff6666666666666666666666666666666 ''
  _rec pr gamma 5 '' false false https://github.test/o/gamma/pull/5 'Tab title \ slash'
  _rec repo zeta main 9999999999999999999999999999999999999999 EXPECTED
} >"$records"

# Run the command under a real pseudo-terminal only for presentation tests.
invoke() {
  if [[ ${CI_TEST_TTY:-0} != 1 ]]; then
    "$@"
    return
  fi
  python3 - "$@" <<'PYTTY'
import errno
import os
import pty
import select
import subprocess
import sys
import time

master, slave = pty.openpty()
child = subprocess.Popen(sys.argv[1:], stdout=slave, stderr=subprocess.STDOUT)
os.close(slave)
deadline = time.monotonic() + 10
try:
    while True:
        if time.monotonic() > deadline:
            child.kill()
            raise RuntimeError("terminal fixture timed out")
        if not select.select([master], [], [], 0.1)[0]:
            continue
        try:
            data = os.read(master, 65536)
        except OSError as error:
            if error.errno == errno.EIO:
                break
            raise
        if not data:
            break
        sys.stdout.buffer.write(data)
finally:
    os.close(master)
    try:
        child.wait(timeout=1)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()
sys.exit(child.returncode)
PYTTY
}

# Run gh-ci-status with arguments "$@" against the stub gh, serving $RECORDS
# (default: the main fixture) and restarting the stub's call counter.
run() {
  rm -f "$fixtures/counter" "${SCHED_DIR:-$sched_dir}"/*.count
  GH_STUB_LOG=$gh_log GH_STUB_JQ_CAPTURE=$jq_capture \
    GH_STUB_SCHED_JQ_CAPTURE=$sched_jq_capture \
    GH_STUB_WORKFLOWS_JQ_CAPTURE=$workflows_jq_capture \
    GH_STUB_REQUIRED_JQ_CAPTURE=$required_jq_capture \
    GH_STUB_CHECKS_JQ_CAPTURE=$checks_jq_capture \
    GH_STUB_STATUSES_JQ_CAPTURE=$statuses_jq_capture \
    GH_STUB_CREDIT_JQ_CAPTURE=$credit_jq_capture \
    GH_STUB_SCHED_DIR="${SCHED_DIR:-$sched_dir}" \
    GH_STUB_COUNTER="$fixtures/counter" GH_STUB_RECORDS="${RECORDS:-$records}" \
    PATH="$stub_bin:$PATH" invoke "$command_path" "$@"
}

# Scheduled runs: epochs are relative to now so the age cutoffs hold no
# matter when the suite runs. Only active workflows are listed; the command's
# jq program does that filtering, which the replay at the end covers.
# Stale runs sit between --stale-days (default 10) and the 45-day cutoff, where
# the schedule is assumed removed or paused and the run is ignored.
now=$(date +%s)
recent=$((now - 3600))
stale=$((now - 15 * 86400))
old=$((now - 50 * 86400))
# Write fixture dir $1's newest-run record for repository $2's workflow $3,
# named $4, with conclusion or status $5 and creation epoch $6.
_sched() {
  local dir=$1 repo=$2 id=$3 name=$4 raw=$5 epoch=$6
  _rec "$id" "$name" "$raw" 2026-01-02T03:04:05Z "$epoch" \
    "https://github.test/o/$repo/actions/runs/$id" >"$dir/$repo.$id"
}
printf '11\n13\n14\n15\n16\n' >"$sched_dir/alpha.workflows"
_sched "$sched_dir" alpha 11 Nightly failure "$recent"
_sched "$sched_dir" alpha 13 Weekly failure "$old"
_sched "$sched_dir" alpha 14 Superseded cancelled "$recent"
_sched "$sched_dir" alpha 16 OldFailure failure "$stale"
printf '21\n' >"$sched_dir/beta.workflows"
_sched "$sched_dir" beta 21 Nightly in_progress "$recent"
: >"$sched_dir/delta.workflows.fail"
printf '31\n32\n' >"$sched_dir/epsilon.workflows"
_sched "$sched_dir" epsilon 31 Nightly success "$recent"
_sched "$sched_dir" epsilon 32 StaleNightly success "$stale"
printf '61\n' >"$sched_dir/gamma.workflows"
_sched "$sched_dir" gamma 61 Approval waiting "$recent"
printf '71\n72\n73\n' >"$sched_dir/zeta.workflows"
_sched "$sched_dir" zeta 71 Timeout timed_out "$recent"
_sched "$sched_dir" zeta 72 Skipper skipped "$recent"
_sched "$sched_dir" zeta 73 CancelledOld cancelled "$stale"
empty_sched=$(_tmpdir)

echo "=== bounded repository pagination ==="

paged_records="$fixtures/paged-records"
_rec repo first-page main aaaaaaa SUCCESS >"$paged_records"
_rec repo last-page main bbbbbbb SUCCESS >"$paged_records.page2"
out=$(GH_STUB_BOUNDED_PAGES=1 RECORDS=$paged_records run --no-scheduled --porcelain 2>&1)
rc=$?
_assert_exit "pagination: bounded repository query succeeds" 0 "$rc"
_assert_contains "pagination: first repository page is included" 'first-page' "$out"
_assert_contains "pagination: later repository pages are included" 'last-page' "$out"

echo "=== status presentation ==="

out=$(NO_COLOR='' run --no-scheduled --color always 2>&1)
rc=$?
_assert_exit "color: rendering preserves failure exit" 1 "$rc"
_assert_contains "color: pass uses Dot green and check" $'\e[38;2;63;185;80m✓ pass' "$out"
_assert_contains "color: fail uses Dot red and cross" $'\e[38;2;248;81;73m✗ fail' "$out"
_assert_contains "color: pending uses yellow and clock" $'\e[38;2;210;153;34m◷ pending' "$out"
_assert_contains "color: no checks uses gray and circle" $'\e[38;2;139;148;158m○ none' "$out"
_assert_contains "color: warnings are distinct" $'\e[38;2;210;153;34m! warning' "$out"
_assert_contains "color: failed summary stands out" $'\e[38;2;248;81;73m✗ summary:' "$out"

out=$(NO_COLOR='' run --no-scheduled --color never 2>&1)
_assert_not_contains "color: never emits no escapes" $'\e[' "$out"
_assert_contains "color: plain output retains symbols" '✗ fail' "$out"
out=$(NO_COLOR='' run --no-scheduled 2>&1)
_assert_not_contains "color: auto leaves redirected output plain" $'\e[' "$out"
out=$(NO_COLOR=1 run --no-scheduled --color=always 2>&1)
_assert_not_contains "color: NO_COLOR overrides always" $'\e[' "$out"
if command -v python3 >/dev/null 2>&1; then
  out=$(NO_COLOR='' TERM=xterm CI_TEST_TTY=1 run --no-scheduled 2>&1)
  _assert_contains "color: auto styles real terminal output" $'\e[38;2;63;185;80m✓ pass' "$out"
  out=$(NO_COLOR='' TERM=dumb CI_TEST_TTY=1 run --no-scheduled 2>&1)
  _assert_not_contains "color: dumb terminal stays plain" $'\e[' "$out"
  out=$(NO_COLOR=1 TERM=xterm CI_TEST_TTY=1 run --no-scheduled 2>&1)
  _assert_not_contains "color: NO_COLOR keeps terminal output plain" $'\e[' "$out"
else
  echo 'SKIP: terminal presentation checks need python3'
fi
plain=$(run --porcelain --no-scheduled)
colored=$(NO_COLOR='' run --porcelain --no-scheduled --color always)
_assert_eq "color: porcelain is byte-identical" "$plain" "$colored"
_assert_not_contains "color: porcelain has no symbols" '✓' "$colored"
out=$(run --color wrong 2>&1)
rc=$?
_assert_exit "color: invalid mode is a usage error" 2 "$rc"
out=$(run --color 2>&1)
rc=$?
_assert_exit "color: missing mode is a usage error" 2 "$rc"

echo "=== default summary ==="

: >"$gh_log"
out=$(run 2>&1)
rc=$?
_assert_exit "summary: a failing item fails the run" 1 "$rc"
_assert_contains "summary: owner defaults to the authenticated user" \
  "owner: stub-user (8 repositories, 4 open pull requests)" "$out"
graphql_call=$(grep 'api graphql' "$gh_log")
_assert_contains "summary: owner is sent as a string field" "-f owner=stub-user" "$graphql_call"
_assert_contains "summary: forks are filtered server-side" "-F isFork=false" "$graphql_call"
_assert_contains "summary: archived repositories are filtered server-side" \
  "-F isArchived=false" "$graphql_call"
_assert_contains "summary: passing branch shows its short commit" \
  "pass     alpha    main@aaaaaaa" "$out"
_assert_contains "summary: failing pull request shows auto-merge" \
  "  ✗ fail     #1 Fix alpha [auto-merge]" "$out"
_assert_contains "summary: failing pull request links to GitHub" \
  "https://github.test/o/alpha/pull/1" "$out"
_assert_contains "summary: a no-checks pull request keeps its later fields" \
  "  ○ none     #4 No checks yet [draft] [auto-merge]" "$out"
_assert_not_contains "summary: a no-checks pull request omits its link" \
  "https://github.test/o/alpha/pull/4" "$out"
_assert_contains "summary: pending branch is reported" "pending  beta" "$out"
_assert_contains "summary: EXPECTED checks are pending" "pending  zeta" "$out"
_assert_contains "summary: ERROR checks fail" "fail     epsilon" "$out"
_assert_contains "summary: draft pull request is labelled" "#2 Draft delta [draft]" "$out"
_assert_not_contains "summary: passing pull request omits its link" \
  "https://github.test/o/delta/pull/2" "$out"
_assert_contains "summary: truncated pull request lists warn" \
  "warning  31 open pull requests; only the oldest 30 are checked" "$out"
_assert_contains "summary: an empty repository has no default branch" \
  "none     empty    no default branch (no checks)" "$out"
_assert_contains "summary: an active workflow without required checks remains none" \
  "none     gamma    main@fffffff (no required checks found)" "$out"
_assert_contains "summary: sanitized titles print verbatim" \
  "#5 Tab title \\ slash" "$out"
_assert_contains "summary: counts cover branches, scheduled runs, and pull requests" \
  "summary: 5 pass, 7 fail, 3 pending, 4 without CI result (7 scheduled runs checked)" "$out"
_assert_contains "scheduled: a failing nightly is listed under its repository" \
  "  ✗ fail     scheduled Nightly: failure (2026-01-02 03:04Z)" "$out"
_assert_contains "scheduled: a failing nightly links to its run" \
  "https://github.test/o/alpha/actions/runs/11" "$out"
_assert_contains "scheduled: a running nightly is pending" \
  "  ◷ pending  scheduled Nightly: in_progress" "$out"
_assert_not_contains "scheduled: a run older than 45 days is ignored" "Weekly" "$out"
_assert_contains "scheduled: a run awaiting approval needs attention" \
  "  ✗ fail     scheduled Approval: waiting" "$out"
_assert_contains "scheduled: a timed-out run fails" "  ✗ fail     scheduled Timeout: timed_out" "$out"
_assert_not_contains "scheduled: a skipped run is ignored" "Skipper" "$out"
_assert_not_contains "scheduled: a cancelled run is ignored" "Superseded" "$out"
_assert_not_contains "scheduled: a cancelled run in the stale window is ignored" \
  "CancelledOld" "$out"
_assert_contains "stale: a passing run that stopped fails instead of reporting ok" \
  "  ✗ fail     scheduled StaleNightly: stale (last success 2026-01-02 03:04Z)" "$out"
_assert_contains "stale: a stale run links to its last run" \
  "https://github.test/o/epsilon/actions/runs/32" "$out"
_assert_contains "stale: a failing run that stopped reports stale with its last conclusion" \
  "  ✗ fail     scheduled OldFailure: stale (last failure 2026-01-02 03:04Z)" "$out"
_assert_not_contains "scheduled: a passing nightly is counted but not listed" \
  "epsilon/actions/runs/31" "$out"
_assert_contains "scheduled: an unreadable repository warns" \
  "warning  scheduled runs could not be read" "$out"
_assert_not_contains "scheduled: a repository without a default branch is not queried" \
  "repos/stub-user/empty/" "$(cat "$gh_log")"
_assert_contains "scheduled: runs are read from the default branch" \
  "-f branch=main" "$(grep 'alpha/actions/workflows/11/runs' "$gh_log")"
_assert_contains "scheduled: each workflow is asked for a few recent runs" \
  "-F per_page=5" "$(grep 'alpha/actions/workflows/11/runs' "$gh_log")"

echo "=== missing rollup visibility ==="

head_records="$fixtures/head-records"
head_sched=$(_tmpdir)
{
  _rec repo no-ci main 1111111111111111111111111111111111111111 ''
  _rec repo untested main 2222222222222222222222222222222222222222 ''
  _rec repo partial main 3333333333333333333333333333333333333333 ''
  _rec repo checked main 4444444444444444444444444444444444444444 ''
  _rec repo failing main 5555555555555555555555555555555555555555 ''
  _rec repo running main 6666666666666666666666666666666666666666 ''
  _rec repo unavailable main 7777777777777777777777777777777777777777 ''
  _rec repo wrong-app main 8888888888888888888888888888888888888888 ''
  _rec repo checks-error main 9999999999999999999999999999999999999999 ''
  _rec repo accepted main aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ''
  _rec repo external main bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ''
  _rec repo status-only main cccccccccccccccccccccccccccccccccccccccc ''
  _rec repo status-conflict main dddddddddddddddddddddddddddddddddddddddd ''
  _rec repo status-wrong-newest main 1212121212121212121212121212121212121212 ''
  _rec repo ruleset main eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee ''
  _rec repo unknown-app main ffffffffffffffffffffffffffffffffffffffff ''
} >"$head_records"
for repo in untested partial checked failing running unavailable wrong-app checks-error accepted status-only status-conflict status-wrong-newest unknown-app; do
  printf '1\n' >"$head_sched/$repo.workflows"
done
_rec Required 15368 >"$head_sched/untested.required"
{
  _rec Required 15368
  _rec 'cgraf78/actions sync' 15368
} >"$head_sched/partial.required"
_rec Required 15368 success completed >"$head_sched/partial.checks"
_rec Dependabot 15368 success completed >>"$head_sched/partial.checks"
cp "$head_sched/partial.required" "$head_sched/checked.required"
{
  _rec Required 15368 success completed
  _rec 'cgraf78/actions sync' 15368 success completed
} >"$head_sched/checked.checks"
_rec Required 15368 >"$head_sched/failing.required"
_rec Required 15368 failure completed >"$head_sched/failing.checks"
_rec Required 15368 >"$head_sched/running.required"
_rec Required 15368 '' in_progress >"$head_sched/running.checks"
: >"$head_sched/unavailable.required.fail"
_rec Required 15368 >"$head_sched/wrong-app.required"
_rec Required 99999 success completed >"$head_sched/wrong-app.checks"
_rec Required 15368 >"$head_sched/checks-error.required"
: >"$head_sched/checks-error.checks.fail"
cp "$head_sched/partial.required" "$head_sched/accepted.required"
{
  _rec Required 15368 neutral completed
  _rec 'cgraf78/actions sync' 15368 skipped completed
} >"$head_sched/accepted.checks"
_rec Required 777 >"$head_sched/external.required"
_rec Required 777 success completed >"$head_sched/external.checks"
_rec Required 15368 >"$head_sched/status-only.required"
_rec Required 15368 success >"$head_sched/status-only.statuses"
_rec Required 15368 >"$head_sched/status-conflict.required"
_rec Required 15368 success completed >"$head_sched/status-conflict.checks"
_rec Required -1 failure >"$head_sched/status-conflict.statuses"
_rec Required 15368 success >>"$head_sched/status-conflict.statuses"
_rec Required 15368 >"$head_sched/status-wrong-newest.required"
_rec Required 15368 success completed >"$head_sched/status-wrong-newest.checks"
_rec Required 99999 success >"$head_sched/status-wrong-newest.statuses"
_rec Required 15368 success >>"$head_sched/status-wrong-newest.statuses"
_rec meta true >"$head_sched/ruleset.required"
{
  _rec meta true
  _rec required Required -2
} >"$head_sched/unknown-app.required"
_rec Required 99999 success completed >"$head_sched/unknown-app.checks"
out=$(RECORDS=$head_records SCHED_DIR=$head_sched run 2>&1)
rc=$?
_assert_exit "missing rollup: a failed required check fails the command" 1 "$rc"
_assert_contains "missing rollup: no active workflows is distinct" \
