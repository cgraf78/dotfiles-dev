#!/usr/bin/env bash
# gh-ci-status-test - owner-wide GitHub CI summary.
#
# A stub gh serves pre-rendered record fixtures, so the suite runs without
# network or jq. The stub also captures the jq programs the command hands to
# gh; where jq exists, they are replayed over equivalent GitHub JSON fixtures
# to prove they render exactly the records the fixtures assume.

set -o pipefail
export NO_COLOR=1
# jq 1.6's fromdateiso8601 applies the local zone's DST offset to UTC
# timestamps, which would shift the replayed epochs on some hosts; gh's
# embedded gojq does not, so pinning UTC only keeps the replay deterministic.
export TZ=UTC

# shellcheck source=dev/helpers.sh
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

command_path="$(_dev_repo_root)/home/.local/bin/gh-ci-status"
fixtures=$(_tmpdir)
stub_bin=$(_mock_bin)
gh_log="$fixtures/gh.log"
jq_capture="$fixtures/records.jq"
sched_jq_capture="$fixtures/sched.jq"
workflows_jq_capture="$fixtures/workflows.jq"
sched_dir="$fixtures/sched"
mkdir -p "$sched_dir"

# One call counter drives --watch: call N serves records.N when present and
# falls back to records, so a sequence of fixtures models checks settling.
# A records.N.fail marker makes call N fail like a transient API error.
# Scheduled runs come from $GH_STUB_SCHED_DIR: <repo>.workflows holds the
# active workflow ids (a missing file means none) and <repo>.workflows.fail
# fails that call. <repo>.<id> is workflow <id>'s newest run record; per-call
# files <repo>.<id>.<N> and <repo>.<id>.<N>.fail override the Nth read of it,
# so --watch can see a run settle or a re-read fail. A <repo>.<id>.json file
# instead holds a raw GitHub runs listing that the stub pipes through the
# command's own jq program, as gh does, so run selection is exercised end to
# end; those cases need jq, and only the .<N>.fail per-call override applies
# to them.
cat >"$stub_bin/gh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$GH_STUB_LOG"
# Print the value of the --jq argument among "$@", if any.
jq_program() {
  while (($#)); do
    if [[ $1 == --jq ]]; then
      printf '%s' "$2"
      return
    fi
    shift
  done
}
if [[ $1 == api && $2 == -X && $3 == GET ]]; then
  path=$4
  [[ $path != --paginate ]] || path=$5
  repo=${path#repos/*/}
  repo=${repo%%/*}
  dir=$GH_STUB_SCHED_DIR
  case $path in
    */actions/workflows)
      jq_program "$@" >"$GH_STUB_WORKFLOWS_JQ_CAPTURE"
      [[ ! -f $dir/$repo.workflows.fail ]] || exit 1
      cat "$dir/$repo.workflows" 2>/dev/null
      exit 0
      ;;
    */actions/workflows/*/runs)
      jq_program "$@" >"$GH_STUB_SCHED_JQ_CAPTURE"
      id=${path%/runs}
      id=${id##*/}
      counter=$dir/$repo.$id.count
      count=$(($(cat "$counter" 2>/dev/null || echo 0) + 1))
      printf '%s\n' "$count" >"$counter"
      [[ ! -f $dir/$repo.$id.$count.fail ]] || exit 1
      if [[ -f $dir/$repo.$id.json ]]; then
        jq -r "$(jq_program "$@")" "$dir/$repo.$id.json"
        exit
      fi
      if [[ -f $dir/$repo.$id.$count ]]; then
        cat "$dir/$repo.$id.$count"
      else
        cat "$dir/$repo.$id" 2>/dev/null
      fi
      exit 0
      ;;
  esac
  exit 2
fi
if [[ $1 == api && $2 == user ]]; then
  [[ -z ${GH_STUB_USER_FAIL:-} ]] || exit 1
  printf '%s\n' "${GH_STUB_USER:-stub-user}"
  exit 0
fi
if [[ $1 == api && $2 == graphql ]]; then
  [[ -z ${GH_STUB_GRAPHQL_FAIL:-} ]] || exit 1
  while (($#)); do
    if [[ $1 == --jq ]]; then
      printf '%s' "$2" >"$GH_STUB_JQ_CAPTURE"
      break
    fi
    shift
  done
  count=$(($(cat "$GH_STUB_COUNTER" 2>/dev/null || echo 0) + 1))
  printf '%s\n' "$count" >"$GH_STUB_COUNTER"
  [[ ! -f $GH_STUB_RECORDS.$count.fail ]] || exit 1
  if [[ -f $GH_STUB_RECORDS.$count ]]; then
    cat "$GH_STUB_RECORDS.$count"
  else
    cat "$GH_STUB_RECORDS"
  fi
  exit 0
fi
exit 2
SH
chmod +x "$stub_bin/gh"

tab=$'\t'
us=$'\x1f'
# Print the arguments as one record joined with the unit separator, matching
# the lines the command's jq program emits.
_rec() {
  local IFS=$us
  printf '%s\n' "$*"
}

records="$fixtures/records"
{
  _rec repo alpha main aaaaaaa1111111111111111111111111111111 SUCCESS
  _rec pr alpha 1 FAILURE false true https://github.test/o/alpha/pull/1 'Fix alpha'
  _rec pr alpha 4 '' true true https://github.test/o/alpha/pull/4 'No checks yet'
  _rec repo beta main ccccccc3333333333333333333333333333333 PENDING
  _rec repo delta main ddddddd4444444444444444444444444444444 SUCCESS
  _rec pr delta 2 SUCCESS true false https://github.test/o/delta/pull/2 'Draft delta'
  _rec truncated delta 31
  _rec repo empty '' '' ''
  _rec repo epsilon main 7777777777777777777777777777777777777777 ERROR
  _rec repo fail main 8888888888888888888888888888888888888888 SUCCESS
  _rec repo gamma main fffffff6666666666666666666666666666666 ''
  _rec pr gamma 5 '' false false https://github.test/o/gamma/pull/5 'Tab title \ slash'
  _rec repo zeta main 9999999999999999999999999999999999999999 EXPECTED
} >"$records"

# Run the command under a real pseudo-terminal only for presentation tests.
invoke() {
  if [[ ${CI_TEST_TTY:-0} != 1 ]]; then
    "$@"
    return
  fi
  python3 - "$@" <<'PYTTY'
import errno
import os
import pty
import select
import subprocess
import sys
import time

master, slave = pty.openpty()
child = subprocess.Popen(sys.argv[1:], stdout=slave, stderr=subprocess.STDOUT)
os.close(slave)
deadline = time.monotonic() + 10
try:
    while True:
        if time.monotonic() > deadline:
            child.kill()
            raise RuntimeError("terminal fixture timed out")
        if not select.select([master], [], [], 0.1)[0]:
            continue
        try:
            data = os.read(master, 65536)
        except OSError as error:
            if error.errno == errno.EIO:
                break
            raise
        if not data:
            break
        sys.stdout.buffer.write(data)
finally:
    os.close(master)
    try:
        child.wait(timeout=1)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()
sys.exit(child.returncode)
PYTTY
}

# Run gh-ci-status with arguments "$@" against the stub gh, serving $RECORDS
# (default: the main fixture) and restarting the stub's call counter.
run() {
  rm -f "$fixtures/counter" "${SCHED_DIR:-$sched_dir}"/*.count
  GH_STUB_LOG=$gh_log GH_STUB_JQ_CAPTURE=$jq_capture \
    GH_STUB_SCHED_JQ_CAPTURE=$sched_jq_capture \
    GH_STUB_WORKFLOWS_JQ_CAPTURE=$workflows_jq_capture \
    GH_STUB_SCHED_DIR="${SCHED_DIR:-$sched_dir}" \
    GH_STUB_COUNTER="$fixtures/counter" GH_STUB_RECORDS="${RECORDS:-$records}" \
    PATH="$stub_bin:$PATH" invoke "$command_path" "$@"
}

# Scheduled runs: epochs are relative to now so the 45-day cutoff holds no
# matter when the suite runs. Only active workflows are listed; the command's
# jq program does that filtering, which the replay at the end covers.
now=$(date +%s)
recent=$((now - 3600))
stale=$((now - 50 * 86400))
# Write fixture dir $1's newest-run record for repository $2's workflow $3,
# named $4, with conclusion or status $5 and creation epoch $6.
_sched() {
  local dir=$1 repo=$2 id=$3 name=$4 raw=$5 epoch=$6
  _rec "$id" "$name" "$raw" 2026-01-02T03:04:05Z "$epoch" \
    "https://github.test/o/$repo/actions/runs/$id" >"$dir/$repo.$id"
}
printf '11\n13\n14\n15\n' >"$sched_dir/alpha.workflows"
_sched "$sched_dir" alpha 11 Nightly failure "$recent"
_sched "$sched_dir" alpha 13 Weekly failure "$stale"
_sched "$sched_dir" alpha 14 Superseded cancelled "$recent"
printf '21\n' >"$sched_dir/beta.workflows"
_sched "$sched_dir" beta 21 Nightly in_progress "$recent"
: >"$sched_dir/delta.workflows.fail"
printf '31\n' >"$sched_dir/epsilon.workflows"
_sched "$sched_dir" epsilon 31 Nightly success "$recent"
printf '61\n' >"$sched_dir/gamma.workflows"
_sched "$sched_dir" gamma 61 Approval waiting "$recent"
printf '71\n72\n' >"$sched_dir/zeta.workflows"
_sched "$sched_dir" zeta 71 Timeout timed_out "$recent"
_sched "$sched_dir" zeta 72 Skipper skipped "$recent"
empty_sched=$(_tmpdir)

echo "=== status presentation ==="

out=$(NO_COLOR='' run --no-scheduled --color always 2>&1)
rc=$?
_assert_exit "color: rendering preserves failure exit" 1 "$rc"
_assert_contains "color: pass uses Dot green and check" $'\e[38;2;63;185;80m✓ pass' "$out"
_assert_contains "color: fail uses Dot red and cross" $'\e[38;2;248;81;73m✗ fail' "$out"
_assert_contains "color: pending uses yellow and clock" $'\e[38;2;210;153;34m◷ pending' "$out"
_assert_contains "color: no checks uses gray and circle" $'\e[38;2;139;148;158m○ none' "$out"
_assert_contains "color: warnings are distinct" $'\e[38;2;210;153;34m! warning' "$out"
_assert_contains "color: failed summary stands out" $'\e[38;2;248;81;73m✗ summary:' "$out"

out=$(NO_COLOR='' run --no-scheduled --color never 2>&1)
_assert_not_contains "color: never emits no escapes" $'\e[' "$out"
_assert_contains "color: plain output retains symbols" '✗ fail' "$out"
out=$(NO_COLOR='' run --no-scheduled 2>&1)
_assert_not_contains "color: auto leaves redirected output plain" $'\e[' "$out"
out=$(NO_COLOR=1 run --no-scheduled --color=always 2>&1)
_assert_not_contains "color: NO_COLOR overrides always" $'\e[' "$out"
if command -v python3 >/dev/null 2>&1; then
  out=$(NO_COLOR='' TERM=xterm CI_TEST_TTY=1 run --no-scheduled 2>&1)
  _assert_contains "color: auto styles real terminal output" $'\e[38;2;63;185;80m✓ pass' "$out"
  out=$(NO_COLOR='' TERM=dumb CI_TEST_TTY=1 run --no-scheduled 2>&1)
  _assert_not_contains "color: dumb terminal stays plain" $'\e[' "$out"
  out=$(NO_COLOR=1 TERM=xterm CI_TEST_TTY=1 run --no-scheduled 2>&1)
  _assert_not_contains "color: NO_COLOR keeps terminal output plain" $'\e[' "$out"
else
  echo 'SKIP: terminal presentation checks need python3'
fi
plain=$(run --porcelain --no-scheduled)
colored=$(NO_COLOR='' run --porcelain --no-scheduled --color always)
_assert_eq "color: porcelain is byte-identical" "$plain" "$colored"
_assert_not_contains "color: porcelain has no symbols" '✓' "$colored"
out=$(run --color wrong 2>&1)
rc=$?
_assert_exit "color: invalid mode is a usage error" 2 "$rc"
out=$(run --color 2>&1)
rc=$?
_assert_exit "color: missing mode is a usage error" 2 "$rc"

echo "=== default summary ==="

: >"$gh_log"
out=$(run 2>&1)
rc=$?
_assert_exit "summary: a failing item fails the run" 1 "$rc"
_assert_contains "summary: owner defaults to the authenticated user" \
  "owner: stub-user (8 repositories, 4 open pull requests)" "$out"
graphql_call=$(grep 'api graphql' "$gh_log")
_assert_contains "summary: owner is sent as a string field" "-f owner=stub-user" "$graphql_call"
_assert_contains "summary: forks are filtered server-side" "-F isFork=false" "$graphql_call"
_assert_contains "summary: archived repositories are filtered server-side" \
  "-F isArchived=false" "$graphql_call"
_assert_contains "summary: passing branch shows its short commit" \
  "pass     alpha    main@aaaaaaa" "$out"
_assert_contains "summary: failing pull request shows auto-merge" \
  "  ✗ fail     #1 Fix alpha [auto-merge]" "$out"
_assert_contains "summary: failing pull request links to GitHub" \
  "https://github.test/o/alpha/pull/1" "$out"
_assert_contains "summary: a no-checks pull request keeps its later fields" \
  "  ○ none     #4 No checks yet [draft] [auto-merge]" "$out"
_assert_not_contains "summary: a no-checks pull request omits its link" \
  "https://github.test/o/alpha/pull/4" "$out"
_assert_contains "summary: pending branch is reported" "pending  beta" "$out"
_assert_contains "summary: EXPECTED checks are pending" "pending  zeta" "$out"
_assert_contains "summary: ERROR checks fail" "fail     epsilon" "$out"
_assert_contains "summary: draft pull request is labelled" "#2 Draft delta [draft]" "$out"
_assert_not_contains "summary: passing pull request omits its link" \
  "https://github.test/o/delta/pull/2" "$out"
_assert_contains "summary: truncated pull request lists warn" \
  "warning  31 open pull requests; only the oldest 30 are checked" "$out"
_assert_contains "summary: an empty repository has no default branch" \
  "none     empty    no default branch (no checks)" "$out"
_assert_contains "summary: repository without CI reports none" \
  "none     gamma    main (no checks)" "$out"
_assert_contains "summary: sanitized titles print verbatim" \
  "#5 Tab title \\ slash" "$out"
_assert_contains "summary: counts cover branches, scheduled runs, and pull requests" \
  "summary: 5 pass, 5 fail, 3 pending, 4 without checks (5 scheduled runs checked)" "$out"
_assert_contains "scheduled: a failing nightly is listed under its repository" \
  "  ✗ fail     scheduled Nightly: failure (2026-01-02 03:04Z)" "$out"
_assert_contains "scheduled: a failing nightly links to its run" \
  "https://github.test/o/alpha/actions/runs/11" "$out"
_assert_contains "scheduled: a running nightly is pending" \
  "  ◷ pending  scheduled Nightly: in_progress" "$out"
_assert_not_contains "scheduled: a run older than 45 days is ignored" "Weekly" "$out"
_assert_contains "scheduled: a run awaiting approval needs attention" \
  "  ✗ fail     scheduled Approval: waiting" "$out"
_assert_contains "scheduled: a timed-out run fails" "  ✗ fail     scheduled Timeout: timed_out" "$out"
_assert_not_contains "scheduled: a skipped run is ignored" "Skipper" "$out"
_assert_not_contains "scheduled: a cancelled run is ignored" "Superseded" "$out"
_assert_not_contains "scheduled: a passing nightly is counted but not listed" \
  "epsilon/actions/runs/31" "$out"
_assert_contains "scheduled: an unreadable repository warns" \
  "warning  scheduled runs could not be read" "$out"
_assert_not_contains "scheduled: a repository without a default branch is not queried" \
  "repos/stub-user/empty/" "$(cat "$gh_log")"
_assert_contains "scheduled: runs are read from the default branch" \
  "-f branch=main" "$(grep 'alpha/actions/workflows/11/runs' "$gh_log")"
_assert_contains "scheduled: each workflow is asked for a few recent runs" \
  "-F per_page=5" "$(grep 'alpha/actions/workflows/11/runs' "$gh_log")"

one_failed=$(_tmpdir)
printf '11\n13\n' >"$one_failed/alpha.workflows"
_sched "$one_failed" alpha 11 Nightly failure "$recent"
: >"$one_failed/alpha.13.1.fail"
out=$(SCHED_DIR=$one_failed run --porcelain 2>&1)
_assert_contains "scheduled: one unreadable workflow marks its repository unreadable" \
  "schederror${tab}none${tab}alpha" "$out"
_assert_not_contains "scheduled: a partly read repository reports no partial results" \
  "sched${tab}fail${tab}alpha" "$out"

: >"$gh_log"
out=$(run --no-scheduled 2>&1)
_assert_contains "no-scheduled: counts exclude scheduled runs" \
  "summary: 4 pass, 2 fail, 2 pending, 4 without checks" "$out"
_assert_not_contains "no-scheduled: makes no Actions API calls" "actions/" "$(cat "$gh_log")"

echo ""
echo "=== filters and porcelain ==="

out=$(run --failing 2>&1)
_assert_contains "failing: keeps a passing branch that has a failing PR" "alpha" "$out"
_assert_contains "failing: keeps pending and failing branches" "beta" "$out"
_assert_contains "failing: keeps truncation warnings" "31 open pull requests" "$out"
_assert_contains "failing: keeps a repository whose PR list is truncated" "delta" "$out"
_assert_not_contains "failing: hides non-problem pull requests" "No checks yet" "$out"
_assert_not_contains "failing: hides repositories without problems" "empty" "$out"
_assert_contains "failing: keeps a repository whose only problem is a scheduled run" \
  "scheduled Approval: waiting" "$out"
_assert_not_contains "failing: hides a passing repository named fail" \
  "pass     fail" "$out"

: >"$gh_log"
run --include-archived --include-forks >/dev/null 2>&1
_assert_not_contains "include: forks are requested when asked" "-F isFork=false" "$(cat "$gh_log")"
_assert_not_contains "include: archived repositories are requested when asked" \
  "-F isArchived=false" "$(cat "$gh_log")"

out=$(run --porcelain --owner=acme 2>&1)
_assert_contains "porcelain: overall state" "state=fail" "$out"
_assert_contains "porcelain: explicit owner" "owner=acme" "$out"
_assert_contains "porcelain: counts" \
  $'pass=5\nfail=5\npending=3\nnone=4\ntruncated=1\nscheduled=5\nsched_errors=1' "$out"
_assert_contains "porcelain: scheduled record" \
  "sched${tab}fail${tab}alpha${tab}Nightly${tab}failure${tab}2026-01-02T03:04:05Z${tab}https://github.test/o/alpha/actions/runs/11" \
  "$out"
_assert_contains "porcelain: passing scheduled runs are listed" \
  "sched${tab}pass${tab}epsilon${tab}Nightly" "$out"
_assert_contains "porcelain: scheduled read failures are listed" \
  "schederror${tab}none${tab}delta" "$out"
_assert_contains "porcelain: repo record" \
  "repo${tab}pass${tab}alpha${tab}main${tab}aaaaaaa1111111111111111111111111111111" "$out"
_assert_contains "porcelain: a no-checks pull request keeps every column" \
  "pr${tab}none${tab}alpha${tab}4${tab}true${tab}true${tab}https://github.test/o/alpha/pull/4${tab}No checks yet" \
  "$out"
_assert_contains "porcelain: an empty repository keeps its empty columns" \
  "repo${tab}none${tab}empty${tab}${tab}" "$out"
out=$(run --porcelain --failing 2>&1)
_assert_not_contains "porcelain failing: filters on the state column only" \
  "repo${tab}pass${tab}fail" "$out"
_assert_contains "porcelain failing: keeps the truncation record" "truncated${tab}none${tab}delta" "$out"
: >"$gh_log"
run --owner acme >/dev/null 2>&1
_assert_not_contains "owner: an explicit owner skips the user lookup" "api user" "$(cat "$gh_log")"

echo ""
echo "=== exit status ==="

pending_records="$fixtures/pending"
grep -v -e FAILURE -e ERROR "$records" >"$pending_records"
RECORDS=$pending_records SCHED_DIR=$empty_sched run >/dev/null 2>&1
_assert_exit "status: pending checks without failures exit 0" 0 "$?"

green_records="$fixtures/green"
grep -v -e FAILURE -e ERROR -e PENDING -e EXPECTED "$records" >"$green_records"
out=$(RECORDS=$green_records SCHED_DIR=$empty_sched run 2>&1)
_assert_exit "status: passing checks exit 0 even with repositories lacking CI" 0 "$?"
_assert_contains "status: repositories lacking CI are still listed" "gamma" "$out"
RECORDS=$green_records run >/dev/null 2>&1
_assert_exit "status: a failing scheduled run fails the run" 1 "$?"

echo ""
echo "=== watch ==="

cp "$pending_records" "$fixtures/watch.1"
: >"$fixtures/watch.2.fail"
cp "$green_records" "$fixtures/watch"
out=$(RECORDS="$fixtures/watch" SCHED_DIR=$empty_sched run --watch --interval=1 2>&1)
_assert_exit "watch: polls until pending checks settle" 0 "$?"
settled_sched=$(_tmpdir)
printf '11\n' >"$settled_sched/alpha.workflows"
_sched "$settled_sched" alpha 11 Nightly failure "$recent"
: >"$gh_log"
RECORDS="$fixtures/watch" SCHED_DIR=$settled_sched run --watch --interval=1 >/dev/null 2>&1
_assert_eq "watch: settled scheduled runs are not re-read" "1" \
  "$(grep -c 'alpha/actions/workflows/11/runs' "$gh_log")"
_assert_contains "watch: explains each wait" "2 pending, 0 failing; checking again in 1s" "$out"
_assert_contains "watch: retries a failed poll" "query failed; retrying" "$out"
_assert_file_content "watch: re-queries after a failed poll" "3" "$fixtures/counter"

pending_sched=$(_tmpdir)
cp "$sched_dir/beta.workflows" "$sched_dir/beta.21" "$pending_sched/"
# alpha's nightly passed: it must be read once and never re-read.
cp "$sched_dir/alpha.workflows" "$pending_sched/"
_sched "$pending_sched" alpha 11 Nightly success "$recent"
: >"$gh_log"
# Only beta's running nightly is pending: its branch passes and nothing fails.
sched_only_records="$fixtures/sched-only"
grep -v -e FAILURE -e ERROR -e EXPECTED "$records" | sed 's/PENDING$/SUCCESS/' >"$sched_only_records"
out=$(RECORDS=$sched_only_records SCHED_DIR=$pending_sched run --watch --interval 1 --timeout 2 2>&1)
_assert_exit "watch: a timeout reports checks still pending" 8 "$?"
if (($(grep -c 'beta/actions/workflows/21/runs' "$gh_log") > 1)); then
  _pass "watch: a pending scheduled run is re-read on each poll"
else
  _fail "watch: a pending scheduled run is re-read on each poll"
fi
_assert_eq "watch: repositories without a pending scheduled run are not re-read" "1" \
  "$(grep -c 'alpha/actions/workflows/11/runs' "$gh_log")"

# A failed re-read must keep the running nightly pending rather than letting
# the warning end the watch as if it had passed.
: >"$pending_sched/beta.21.2.fail"
out=$(RECORDS=$sched_only_records SCHED_DIR=$pending_sched run --watch --interval 1 --timeout 2 2>&1)
_assert_exit "watch: a failed re-read keeps the scheduled run pending" 8 "$?"
_assert_not_contains "watch: a failed re-read does not warn over the kept result" \
  "scheduled runs could not be read" "$out"
rm -f "$pending_sched/beta.21.2.fail"
_assert_contains "watch: a timeout is explained" \
  "stopped watching after 2s with checks still pending" "$out"

echo ""
echo "=== batching ==="

# More repositories than one batch of concurrent queries: records must still
# follow the repository order.
batch_records="$fixtures/batch"
batch_sched=$(_tmpdir)
expected_order=
: >"$batch_records"
for n in 01 02 03 04 05 06 07 08 09 10 11; do
  _rec repo "r$n" main "${n}00000000000000000000000000000000000000" SUCCESS >>"$batch_records"
  printf '9%s\n' "$n" >"$batch_sched/r$n.workflows"
  _sched "$batch_sched" "r$n" "9$n" Nightly success "$recent"
  expected_order+="r$n "
done
out=$(RECORDS=$batch_records SCHED_DIR=$batch_sched run --porcelain 2>&1)
_assert_contains "batching: every repository's scheduled run is read" "scheduled=11" "$out"
_assert_eq "batching: scheduled records keep repository order" "$expected_order" \
  "$(printf '%s\n' "$out" | awk -F'\t' '$1 == "sched" {printf "%s ", $3}')"

echo ""
echo "=== scheduled run ordering ==="

# GitHub's filtered runs listing can return runs out of order, so the newest
# run must be chosen by creation time rather than listing position. These
# fixtures are raw listings that the stub renders with the command's own jq
# program; the older success is listed first.
if command -v jq >/dev/null 2>&1; then
  order_records="$fixtures/order"
  _rec repo alpha main aaaaaaa1111111111111111111111111111111 SUCCESS >"$order_records"
  order_sched=$(_tmpdir)
  printf '41\n' >"$order_sched/alpha.workflows"
  older_at=$(jq -nr --argjson e "$((recent - 86400))" '$e | todate')
  newer_at=$(jq -nr --argjson e "$recent" '$e | todate')
  cat >"$order_sched/alpha.41.json" <<JSON
{"total_count":2,"workflow_runs":[
 {"id":900,"workflow_id":41,"name":"Tests","conclusion":"success","status":"completed","created_at":"$older_at","html_url":"https://github.test/o/alpha/actions/runs/900"},
 {"id":800,"workflow_id":41,"name":"Tests","conclusion":"failure","status":"completed","created_at":"$newer_at","html_url":"https://github.test/o/alpha/actions/runs/800"}
]}
JSON
  out=$(RECORDS=$order_records SCHED_DIR=$order_sched run --porcelain 2>&1)
  rc=$?
  _assert_exit "ordering: a newer failure listed after an older success fails the run" 1 "$rc"
  _assert_contains "ordering: the overall state reflects the newest run" "state=fail" "$out"
  _assert_contains "ordering: the newest run by creation time is reported" \
    "sched${tab}fail${tab}alpha${tab}Tests${tab}failure${tab}$newer_at${tab}https://github.test/o/alpha/actions/runs/800" \
    "$out"

  # Runs created in the same second fall back to the larger run id, compared
  # as a number: 10 is newer than 9 whichever is listed first.
  for listing in '9 10' '10 9'; do
    : >"$order_sched/alpha.41.json.runs"
    for run_id in $listing; do
      if [[ $run_id == 10 ]]; then conclusion=failure; else conclusion=success; fi
      printf '{"id":%s,"workflow_id":41,"name":"Tests","conclusion":"%s","status":"completed","created_at":"%s","html_url":"https://github.test/o/alpha/actions/runs/%s"}\n' \
        "$run_id" "$conclusion" "$newer_at" "$run_id" >>"$order_sched/alpha.41.json.runs"
    done
    jq -s '{total_count: length, workflow_runs: .}' "$order_sched/alpha.41.json.runs" \
      >"$order_sched/alpha.41.json"
    out=$(RECORDS=$order_records SCHED_DIR=$order_sched run --porcelain 2>&1)
    _assert_contains "ordering: a same-second tie picks the larger run id (listed ${listing// /, })" \
      "sched${tab}fail${tab}alpha${tab}Tests${tab}failure${tab}$newer_at${tab}https://github.test/o/alpha/actions/runs/10" \
      "$out"
  done
else
  echo "  SKIP: scheduled run ordering (jq unavailable)"
fi

