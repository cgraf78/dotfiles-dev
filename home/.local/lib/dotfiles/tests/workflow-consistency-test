  checkrun_command=$DOT_TEST_CHECKRUN_ROOT/bin/checkrun
  checkrun_nvim_fixture=$DOT_TEST_CHECKRUN_ROOT/lib/checkrun/nvim.lua
  sley_extension=$DOT_TEST_SLEY_ROOT/share/sley/vscode/sley-tools-0.0.1/extension.js
  agentguard_classifier=$DOT_TEST_AGENTGUARD_ROOT/bin/agentguard-classify-command
  for provider_asset in "$checkrun_command" "$checkrun_nvim_fixture" \
    "$sley_extension" "$agentguard_classifier"; do
    [[ -r $provider_asset ]] || {
      echo "workflow-consistency-test: provider asset unavailable: $provider_asset" >&2
      exit 1
    }
  done
else
  provider_scope=hermetic
  provider_bin=$work/provider-bin
  checkrun_nvim_fixture=$work/checkrun-nvim.lua
  sley_extension=$work/sley-extension/extension.js
  mkdir -p "$provider_bin" "${sley_extension%/*}"
  cat >"$provider_bin/checkrun" <<'PY'
#!/usr/bin/env python3
import json
import os
import pathlib
import sys

metadata = json.loads(pathlib.Path(os.environ["CHECKRUN_TEST_METADATA"]).read_text())
fixture = json.loads(pathlib.Path(os.environ["CHECKRUN_TEST_FIXTURE"]).read_text())
if sys.argv[1:3] == ["capabilities", "--json"]:
    print(json.dumps(metadata["capabilities"]))
elif sys.argv[1:3] == ["registry", "--json"]:
    print(json.dumps({"selectors": [{"format": [{"tool": "sley"}], "lint": [{"tool": "sley"}]}]}))
elif len(sys.argv) >= 5 and sys.argv[1:3] == ["plan", "--json"] and sys.argv[3] == "--phase":
    phase = sys.argv[4]
    by_name = {item["path"]: item for item in fixture["languages"]}
    files = []
    for raw in sys.argv[5:]:
        path = pathlib.Path(raw)
        item = next(value for name, value in by_name.items() if raw.endswith("/" + name))
        tools = item.get("lintTools", ["sley"]) if phase == "lint" else ["sley"]
        steps = [{"tool": tool} for tool in tools] if item[phase] else []
        files.append({"path": str(path.resolve()), "filetype": item["filetype"], phase: {"steps": steps}})
    print(json.dumps({"files": files}))
else:
    raise SystemExit(2)
PY
  cat >"$provider_bin/cmp" <<'PY'
#!/usr/bin/env python3
import pathlib
import sys

raise SystemExit(0 if pathlib.Path(sys.argv[-2]).read_bytes() == pathlib.Path(sys.argv[-1]).read_bytes() else 1)
PY
  cat >"$sley_extension" <<'NODE'
function languageToFiletypes(languageMap) {
  const result = {};
  for (const [filetype, languages] of Object.entries(languageMap || {})) {
    for (const language of languages) {
      (result[language] ||= []).push(filetype);
    }
  }
  return result;
}
function providerSelector(filetypes, languageMap, phase) {
  const enabled = new Set(filetypes[phase] || []);
  const result = [];
  for (const filetype of enabled) {
    const languages = languageMap[filetype] || [filetype];
    for (const language of languages) result.push({ language, scheme: "file" });
  }
  return result;
}
function supports(document, filetypes, byLanguage, phase) {
  const enabled = new Set(filetypes[phase] || []);
  return enabled.has(document.languageId) ||
    (byLanguage[document.languageId] || []).some(filetype => enabled.has(filetype));
}
module.exports = { _test: { languageToFiletypes, providerSelector, supports } };
NODE
  cat >"$checkrun_nvim_fixture" <<'LUA'
