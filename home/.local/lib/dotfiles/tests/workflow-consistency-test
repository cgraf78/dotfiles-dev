fi

work=$(_tmpdir)
checkrun_command=
checkrun_nvim_fixture=
sley_extension=
agentguard_classifier=
if [[ -n ${DOT_TEST_CHECKRUN_ROOT:-} || -n ${DOT_TEST_SLEY_ROOT:-} ||
  -n ${DOT_TEST_AGENTGUARD_ROOT:-} ]]; then
  : "${DOT_TEST_CHECKRUN_ROOT:?provider compatibility requires Checkrun}"
  : "${DOT_TEST_SLEY_ROOT:?provider compatibility requires Sley}"
  : "${DOT_TEST_AGENTGUARD_ROOT:?provider compatibility requires AgentGuard}"
