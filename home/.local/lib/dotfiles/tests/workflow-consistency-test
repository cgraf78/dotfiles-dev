           for item in custom["patterns"])

items = associations["associations"]
names = [item["name"] for item in items]
assert len(names) == len(set(names))
assert all(item.get("matches") for item in items)
assert all(isinstance(item.get("enforce", True), bool) for item in items)
required = {
    "Checkrun schema association policy",
    "Sley verify registry",
    "GitHub CLI config layers",
    "Claude Code settings layers",
    "mise global config",
}
assert required.issubset(names), sorted(required - set(names))

ignored = settings["settingsSync.ignoredSettings"]
assert ignored == sorted(set(ignored))
assert {
    "evenBetterToml.schema.associations",
    "json.schemas",
    "yaml.schemas",
}.issubset(ignored)
print(f"format={len(cap['filetypes']['format'])} lint={len(cap['filetypes']['lint'])} associations={len(items)}")
PY
)
_assert_exit 'Checkrun metadata and editor projections satisfy exact policy invariants' 0 "$?"
_pass "Projection inventory: $projection_output"

fixture=$owner_root/home/.local/lib/dotfiles/tests/fixtures/common-language-policy.json
