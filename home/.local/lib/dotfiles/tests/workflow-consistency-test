_assert_file_exists 'Checkrun schema association policy is dev-owned' "$associations"
_assert_contains 'Git activates the dev-owned hook directory' '.local/lib/dotfiles/git-hooks' "$(<"$git_config")"
_assert_contains 'Sley provider is installed by dev' 'cgraf78/sley' "$(<"$deps")"
_assert_contains 'Checkrun provider is installed by dev' 'cgraf78/checkrun' "$(<"$deps")"
_assert_contains 'VS Code activates the provider-owned Sley extension' 'share/sley/vscode' "$(<"$vscode_extensions")"
_assert_contains 'Nvim resolves Checkrun through the dependency boundary' 'cgraf78/checkrun' "$(<"$checkrun_adapter")"
_assert_contains 'Nvim derives formatter policy from Checkrun capabilities' 'sley_formatters_by_ft' "$(<"$language_policy")"
_assert_contains 'Nvim derives linter policy from Checkrun capabilities' 'sley_linters_by_ft' "$(<"$language_policy")"
_assert_contains 'Nvim formatter consumes the shared language policy' 'config.language-policy' "$(<"$formatting_plugin")"
_assert_contains 'Nvim linter consumes the shared language policy' 'config.language-policy' "$(<"$linting_plugin")"
_assert_contains 'VS Code keeps generated Checkrun settings out of sync' 'evenBetterToml.schema.associations' "$(<"$vscode_settings")"
_assert_contains 'VS Code excludes dependency trees from Sley diagnostics' '**/node_modules/**' "$(<"$vscode_settings")"

