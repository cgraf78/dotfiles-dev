#!/usr/bin/env bash
# workflow-consistency-test - exact dev-owned editor/workflow projections.
set -euo pipefail
export NO_COLOR=1
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

owner_root=$(_dev_repo_root)
root=$owner_root/home
metadata=$root/.config/nvim/checkrun-editor-metadata.json
associations=$root/.config/checkrun/associations.json
vscode_settings=$root/.config/dot/merge-hooks.d/vscode/settings.d/10-settings.json
vscode_extensions=$root/.config/dot/merge-hooks.d/vscode/local-extensions.d/10-extensions.tsv
language_policy=$root/.config/nvim/lua/config/language-policy.lua
checkrun_adapter=$root/.config/nvim/lua/config/checkrun-nvim.lua
formatting_plugin=$root/.config/nvim/lua/plugins/formatting.lua
linting_plugin=$root/.config/nvim/lua/plugins/linting.lua
git_config=$root/.config/git/config
deps=$root/.config/shdeps/30-dev.conf

_assert_no_low_level_dispatch() {
  local registry=$1 violations=$2 classifier=${3:-}

  [[ -x $classifier ]] || {
    _fail 'workflow surfaces: immutable AgentGuard classifier is available'
    return
  }

  jq -r '
    [
      .selectors[]? | ((.format // []) + (.lint // []))[]?.tool,
      .crossCutting.lint[]?.tool,
      "mypy", "pyre", "prettier"
    ]
    | flatten
    | map(select(type == "string" and test("^[A-Za-z0-9_.+-]+$")))
    | map(select(. as $tool | ["cargo", "crontab", "php", "tmux", "zsh"] | index($tool) | not))
    | unique
    | .[]
  ' "$registry" >"${violations%/*}/low-level-tools.txt"

  git -C "$owner_root" ls-files -- \
    home/.config/dot/merge-hooks.d \
    home/.config/nvim/lua/config/checkrun-nvim.lua \
    home/.config/nvim/lua/config/language-policy.lua \
    home/.config/nvim/lua/config/schema-policy.lua \
    home/.config/nvim/lua/config/sley-nvim.lua \
    home/.config/nvim/lua/plugins/formatting.lua \
    home/.config/nvim/lua/plugins/linting.lua \
    home/.config/nvim/lua/plugins/sley.lua \
    home/.local/lib/dotfiles/git-hooks \
    >"${violations%/*}/workflow-surface-files.txt"

  DOTFILES_ROOT="$owner_root" AGENTGUARD_CLASSIFIER="$classifier" \
    python3 - "${violations%/*}/low-level-tools.txt" \
    "${violations%/*}/workflow-surface-files.txt" >"$violations" <<'PY'
import json
import os
import re
import subprocess
import sys

root = os.environ["DOTFILES_ROOT"]
classifier = os.environ["AGENTGUARD_CLASSIFIER"]
tools_path, files_path = sys.argv[1], sys.argv[2]
with open(tools_path, encoding="utf-8") as handle:
    tools = [line.strip() for line in handle if line.strip()]
tool_names = set(tools)
seam = r"""(?:["'\\])*"""
loose = "|".join(
    seam.join(re.escape(char) for char in tool)
    for tool in sorted(tools, key=len, reverse=True)
)
token = re.compile(rf"(^|[^A-Za-z0-9_.+-])(?:{loose})(?:$|[^A-Za-z0-9_.+-])")
js_exec = re.compile(r"\b(?:execFile|spawn|run)\(\s*['\"]")
lua_exec = re.compile(r"\b(?:jobstart\(\s*\{|cmd\s*=\s*\{)\s*['\"]")
json_command = re.compile(r'"(?:cmd|command)"\s*:\s*("(?:\\.|[^"\\])*")')

def classify(commands):
    unique = list(dict.fromkeys(command.rstrip("\n") for command in commands if "\n" not in command and token.search(command)))
    if not unique:
        return {}
    result = subprocess.run(
        [classifier, "--json-lines"],
        input="".join(f"{command}\n" for command in unique),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    return {
        payload["input"]: {
            item.get("basename", "")
            for item in payload.get("commands", [])
            if isinstance(item, dict)
        }
        for payload in map(json.loads, result.stdout.splitlines())
    }

parser_examples = [
    "if ! prettier --check .; then",
    "{ prettier --check .; }",
    "env -u GIT_DIR prettier --check .",
    "xargs -r -n 1 prettier --check",
    'env -u GIT_DIR ru"ff" check .',
    r"ru\ff check .",
]
parser_classified = classify(parser_examples + ["prettier --check ."])
for example in parser_examples:
    if not (parser_classified.get(example, set()) & tool_names):
        print(f"<parser-self-test>: expected direct tool command in: {example}")
json_example = json.loads('"prettier --check ."')
if not (parser_classified.get(json_example, set()) & tool_names):
    print("<parser-self-test>: expected direct tool command in JSON command key")

def active(line, relpath):
    stripped = line.lstrip()
    if stripped.startswith("#") or stripped.startswith("--") or '"Bash(' in line:
        return ""
    return re.sub(r"//.*$", "", line) if relpath.endswith(".js") else line

checks = []
violations = set()
with open(files_path, encoding="utf-8") as handle:
    paths = [line.strip() for line in handle if line.strip()]
for relpath in paths:
    with open(os.path.join(root, relpath), encoding="utf-8") as handle:
        for line_no, line in enumerate(handle, 1):
            code = active(line, relpath)
            if not code:
                continue
            if js_exec.search(code) or lua_exec.search(code):
                if token.search(code):
                    violations.add((relpath, line_no, line.rstrip()))
            if token.search(code):
                checks.append((relpath, line_no, line.rstrip(), code))
            for match in json_command.finditer(code):
                command = json.loads(match.group(1))
                if token.search(command):
                    checks.append((relpath, line_no, line.rstrip(), command))
classified = classify([command for _, _, _, command in checks])
for relpath, line_no, text, command in checks:
    if classified.get(command.rstrip("\n"), set()) & tool_names:
        violations.add((relpath, line_no, text))
for record in sorted(violations):
    print(f"{record[0]}:{record[1]}: {record[2]}")
PY

  if [[ -s $violations ]]; then
    _fail 'workflow surfaces: low-level tools stay behind Checkrun/Sley'
    sed 's/^/    /' "$violations" >&2
  else
    _pass 'workflow surfaces: low-level tools stay behind Checkrun/Sley'
  fi
}

