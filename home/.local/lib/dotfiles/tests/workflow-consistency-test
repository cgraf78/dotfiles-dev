  SLEY_VSCODE_EXTENSION_PATH=${sley_extension%/extension.js} \
    node - "$cap" "$settings" "$fixture" "$repo" <<'NODE'
const assert = require("node:assert/strict");
const fs = require("node:fs");
const Module = require("node:module");
const path = require("node:path");
const cap = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const settings = JSON.parse(fs.readFileSync(process.argv[3], "utf8"));
const fixture = JSON.parse(fs.readFileSync(process.argv[4], "utf8"));
const repo = process.argv[5];
const originalLoad = Module._load;
Module._load = function load(request, parent, isMain) {
  if (request === "vscode") {
    return {
      Diagnostic: class {}, DiagnosticSeverity: {}, Position: class {}, Range: class {}, TextEdit: {},
      commands: {}, languages: {}, window: {},
      workspace: { getConfiguration: () => ({ get: () => undefined }), getWorkspaceFolder: () => undefined },
    };
  }
  return originalLoad.call(this, request, parent, isMain);
};
try {
  const extension = require(path.join(process.env.SLEY_VSCODE_EXTENSION_PATH, "extension.js"));
  const languageMap = cap.editorLanguageIds?.vscode || {};
  const byLanguage = extension._test.languageToFiletypes(languageMap);
  const selected = new Set(extension._test.providerSelector(cap.filetypes, languageMap, "format").map(x => x.language).filter(Boolean));
  const configured = Object.entries(settings)
    .filter(([key, value]) => /^\[.+\]$/.test(key) && value?.["editor.defaultFormatter"] === "cgraf.sley-tools")
    .map(([key]) => key.slice(1, -1));
  assert.deepEqual([...selected].sort(), configured.sort());
  for (const item of fixture.languages) {
    const file = path.join(repo, item.path);
    for (const languageId of item.vscodeLanguages) {
      const doc = { isUntitled: false, languageId, uri: { fsPath: file, scheme: "file" }, getText: () => fs.readFileSync(file, "utf8") };
      assert.equal(extension._test.supports(doc, cap.filetypes, byLanguage, "format"), item.format);
      assert.equal(extension._test.supports(doc, cap.filetypes, byLanguage, "lint"), item.lint);
    }
  }
} finally {
  Module._load = originalLoad;
}
NODE
  _assert_exit 'Provider Sley extension and generated VS Code settings match Checkrun' 0 "$?"
