echo '=== Dev workspace callbacks ==='
workspace_callback_root=$(_tmpdir)
mkdir -p "$workspace_callback_root/project/.git" "$workspace_callback_root/outside"
output=$(DOT_TEST_WORKSPACE_CALLBACK_ROOT="$workspace_callback_root" _nvim_lua '
  local spec = dofile(vim.fn.expand("~/.config/nvim/lua/dotfiles/plugin_overrides/workspace-dev.lua"))[1]
  local root = vim.env.DOT_TEST_WORKSPACE_CALLBACK_ROOT
  -- The editor layer supplies the marker detector; dev extends it with Sley.
  local marker_calls = {}
  local opts = {
    workspace = {
      repo_root_detector = function(cwd, detector_opts)
        table.insert(marker_calls, detector_opts)
        if cwd == root .. "/project" then return root .. "/project" end
      end,
    },
  }
  spec.opts(nil, opts)
  local old_system = vim.system
  vim.system = function() error("Sley must not run when the marker detector finds a root") end
  local passed = { marker_root = root .. "/project" }
  assert(opts.workspace.repo_root_detector(root .. "/project", passed) == root .. "/project")
  assert(marker_calls[1] == passed)
  vim.fn.executable = function(command) return command == "sley" and 1 or 0 end
  vim.system = function(command, options)
    assert(table.concat(command, " ") == "sley status --json")
    assert(options.cwd == root .. "/outside")
    assert(options.env.SLEY_SKIP_BARE_REPO_FALLBACK == "1")
    return { wait = function() return { code = 0, stdout = vim.json.encode({ root = root }) } end }
  end
  assert(opts.workspace.repo_root_detector(root .. "/outside") == root)
  vim.system = function() error("sley failure") end
  assert(opts.workspace.repo_root_detector(root .. "/outside") == nil)
  -- Without an editor detector to extend, Sley is the only source.
  local bare = {}
  spec.opts(nil, bare)
  vim.system = function()
    return { wait = function() return { code = 0, stdout = vim.json.encode({ root = root }) } end }
  end
  assert(bare.workspace.repo_root_detector(root .. "/project") == root)
  vim.system = old_system
  print("workspace-callbacks-ok")
')
_assert_eq 'Workspace callback extends the editor detector, consumes Sley, and fails closed' \
  'workspace-callbacks-ok' "$output"

# lazy.nvim keeps one `init` per plugin, so an `init` here would replace the
# editor overlay's nvim-workspace init and drop its Ctrl-click mapping.
output=$(_nvim_lua '
  local spec = dofile(vim.fn.expand("~/.config/nvim/lua/dotfiles/plugin_overrides/workspace-dev.lua"))[1]
  print("init=" .. tostring(spec.init))
  print("config=" .. tostring(spec.config))
')
_assert_eq 'Workspace dev spec leaves the editor init and config in place' \
  $'init=nil\nconfig=nil' "$output"

output=$(_nvim_lua '
  local registered = {}
  local scheduled = false
  vim.api.nvim_create_autocmd = function(event, opts)
    assert(event == "User" and opts.pattern == "VeryLazy")
    table.insert(registered, opts.callback)
  end
  vim.schedule = function(fn) scheduled = true; fn() end
  package.loaded["config.keymaps.workspace-dev"] = { setup = function() print("setup") end }
  dofile(vim.fn.expand("~/.config/nvim/lua/dotfiles/plugin_overrides/workspace-dev.lua"))
  print("hooks=" .. #registered)
  registered[1]()
  print("scheduled=" .. tostring(scheduled))
')
_assert_eq 'Workspace dev spec import schedules its keymap callback after VeryLazy' \
  $'hooks=1\nsetup\nscheduled=true' "$output"

# Re-importing the spec (lazy reload) must replace the hook, not stack a copy.
output=$(_nvim_lua '
  package.loaded["config.keymaps.workspace-dev"] = { setup = function() print("setup") end }
  local path = vim.fn.expand("~/.config/nvim/lua/dotfiles/plugin_overrides/workspace-dev.lua")
  dofile(path)
  dofile(path)
  vim.schedule = function(fn) fn() end
  vim.api.nvim_exec_autocmds("User", { pattern = "VeryLazy" })
')
_assert_eq 'Workspace dev spec re-import keeps a single keymap hook' 'setup' "$output"
