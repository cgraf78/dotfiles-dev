echo '=== Mason fallback policy ==='
output=$(_nvim_lua '
  local policy = require("config.mason-policy")
  local original_path = vim.env.PATH
  local bin = vim.fn.tempname()
  vim.fn.mkdir(bin, "p")
  for _, command in ipairs({ "stylua", "cmake-format", "cmake-lint", "rust-analyzer" }) do
    local path = bin .. "/" .. command
    vim.fn.writefile({ "#!/bin/sh" }, path)
    vim.fn.setfperm(path, "rwx------")
  end
  vim.env.PATH = bin
  local opts = { ensure_installed = { "stylua", "cmakelang", "cmakelint", "cmakelint", "codelldb" } }
  policy.apply_mason_opts(opts)
  assert(opts.PATH == "append")
  assert(not vim.tbl_contains(opts.ensure_installed, "stylua"))
  assert(not vim.tbl_contains(opts.ensure_installed, "cmakelang"))
  assert(not vim.tbl_contains(opts.ensure_installed, "rust-analyzer"))
  local count = 0
  for _, package in ipairs(opts.ensure_installed) do if package == "cmakelint" then count = count + 1 end end
  assert(count == 1 and vim.tbl_contains(opts.ensure_installed, "codelldb"))
  local packages = policy.lsp_server_packages()
  assert(packages.biome == "biome" and packages.cssls == "css-lsp" and packages.vtsls == "vtsls")
  vim.env.PATH = original_path
  vim.g.mason_disabled = true
  assert(policy.mason_enabled() == false)
  local lsp_opts = { servers = { available = { cmd = { "sh" } }, missing = { cmd = { "missing-lsp" } } }, setup = {} }
  policy.apply_lsp_policy(lsp_opts)
  assert(lsp_opts.servers.available.mason == false)
  assert(lsp_opts.setup["*"]("missing", { cmd = { "missing-lsp" } }) == true)
  vim.fn.delete(bin, "rf")
  print("mason-policy-ok")
')
_assert_eq 'Mason remains a deduplicated fallback behind external tools' \
  'mason-policy-ok' "$output"

