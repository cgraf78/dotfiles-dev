echo '=== Debug keys ==='
# The VS Code debug keys are spec keys, so lazy.nvim describes them and loads
# nvim-dap on first press. Stub dap to check each key reaches its action; the
# shifted keys share an action with their legacy F17/F23 encodings.
output=$(_nvim_lua '
  local calls = {}
  local function record(name) return function() calls[#calls + 1] = name end end
  package.loaded["dap"] = {
    continue = record("continue"),
    terminate = record("terminate"),
    toggle_breakpoint = record("toggle_breakpoint"),
    step_over = record("step_over"),
    step_into = record("step_into"),
    step_out = record("step_out"),
    repl = { toggle = record("repl.toggle") },
  }
  local spec = dofile(vim.fn.expand("~/.config/nvim/lua/plugins/debug.lua"))[1]
  assert(spec[1] == "mfussenegger/nvim-dap" and spec.optional == true)
  local lines = {}
  for _, key in ipairs(spec.keys) do
    calls = {}
    key[2]()
    lines[#lines + 1] = key[1] .. "=" .. key.desc .. ":" .. table.concat(calls, ",")
  end
  print(table.concat(lines, "|"))
')
