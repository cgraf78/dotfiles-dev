  assert(not vim.tbl_contains(opts.ensure_installed, "cmakelang"))
  assert(not vim.tbl_contains(opts.ensure_installed, "rust-analyzer"))
  local count = 0
  for _, package in ipairs(opts.ensure_installed) do if package == "cmakelint" then count = count + 1 end end
  assert(count == 1 and vim.tbl_contains(opts.ensure_installed, "codelldb"))
  local packages = policy.lsp_server_packages()
  assert(packages.biome == "biome" and packages.cssls == "css-lsp" and packages.vtsls == "vtsls")
