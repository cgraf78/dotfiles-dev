#!/usr/bin/env bash
set -euo pipefail
. "${BASH_SOURCE[0]%/*}/dev/helpers.sh"

NVIM_TEST_BIN=${NVIM_TEST_BIN:-$(command -v nvim 2>/dev/null || true)}
if [[ -z $NVIM_TEST_BIN ]]; then
  _fail 'Development Nvim tests require nvim'
  _test_summary
fi

_nvim_lua() {
  local lua_dir=$HOME/.config/nvim/lua
  "$NVIM_TEST_BIN" --headless --noplugin -u NONE -i NONE \
    -c "lua package.path='$lua_dir/?.lua;' .. package.path; $1" \
    -c 'qa!' 2>&1
}

echo '=== Development Nvim boundary ==='
_assert_contains 'Mason policy is dev-owned' 'lsp_server_packages' "$(<"$HOME/.config/nvim/lua/config/mason-policy.lua")"
_assert_contains 'Diffview is dev-owned' 'sindrets/diffview.nvim' "$(<"$HOME/.config/nvim/lua/plugins/git-dev.lua")"
_assert_not_contains 'Basic Gitsigns stays in editor' 'lewis6991/gitsigns.nvim' "$(<"$HOME/.config/nvim/lua/plugins/git-dev.lua")"
workspace_overrides=$HOME/.config/nvim/lua/dotfiles/plugin_overrides/workspace-dev.lua
_assert_contains 'Workspace dev layer owns Lazygit' 'config.keymaps.workspace-dev' \
  "$(<"$workspace_overrides")"
_assert_contains 'Workspace dev layer owns Sley root detection' 'repo_root_detector' \
  "$(<"$workspace_overrides")"
_assert_contains 'Workspace dev layer owns Lazygit options' 'opts_for_path' \
  "$(<"$workspace_overrides")"
dev_overrides=$HOME/.config/nvim/lua/dotfiles/plugin_overrides/dev-tools.lua
_assert_file_exists 'Dev plugin overrides use the post-plugin extension point' \
  "$dev_overrides"
dev_overrides_content=
[[ ! -f $dev_overrides ]] || dev_overrides_content=$(<"$dev_overrides")
for plugin in \
  neovim/nvim-lspconfig \
  mason-org/mason.nvim \
  mason-org/mason-lspconfig.nvim \
  stevearc/conform.nvim \
  mfussenegger/nvim-lint \
  folke/lazydev.nvim; do
  _assert_contains \
    "Dev layer re-enables $plugin" \
    "{ \"$plugin\", enabled = true }" \
    "$dev_overrides_content"
done
dev_extras=$HOME/.config/nvim/lua/dotfiles/lazyvim_extras/dev.lua
_assert_file_exists 'Dev LazyVim extras use the pre-plugin extension point' "$dev_extras"
dev_extras_content=
[[ ! -f $dev_extras ]] || dev_extras_content=$(<"$dev_extras")
_assert_contains 'Dev layer preserves LazyVim dotfile support' \
  '{ import = "lazyvim.plugins.extras.util.dot" }' \
  "$dev_extras_content"
_assert_not_contains 'Custom plugin specs do not import LazyVim extras too late' \
  'lazyvim.plugins.extras.' \
  "$(grep -R -n 'lazyvim\.plugins\.extras\.' "$HOME/.config/nvim/lua/plugins" || true)"
_assert_file_missing 'Retired filename-ordered dev overrides are absent' \
  "$HOME/.config/nvim/lua/plugins/zz-dev-extras.lua"
_assert_file_missing 'Retired filename-ordered Mason policy is absent' \
  "$HOME/.config/nvim/lua/plugins/zz-mason-policy.lua"
_assert_file_missing 'Retired filename-ordered workspace policy is absent' \
  "$HOME/.config/nvim/lua/plugins/workspace-dev.lua"

output=$(
  _nvim_lua '
local later = dofile(vim.fn.expand("~/.config/nvim/lua/dotfiles/plugin_overrides/dev-tools.lua"))
local earlier = {
  { "neovim/nvim-lspconfig", enabled = false },
  { "mason-org/mason.nvim", enabled = false },
  { "mason-org/mason-lspconfig.nvim", enabled = false },
  { "stevearc/conform.nvim", enabled = false },
  { "mfussenegger/nvim-lint", enabled = false },
  { "folke/lazydev.nvim", enabled = false },
}
local expected = vim.deepcopy(earlier)
local state = {}
for _, spec in ipairs(earlier) do
  if spec[1] then state[spec[1]] = spec.enabled end
end
for _, spec in ipairs(later) do
  if spec[1] then state[spec[1]] = spec.enabled end
end
for _, spec in ipairs(expected) do
  assert(state[spec[1]] == true, spec[1] .. " was not re-enabled by the later dev spec")
end
print("effective-dev-state-ok")
'
)
_assert_eq 'Later dev spec overrides the editor disable contract' \
  'effective-dev-state-ok' "$output"

