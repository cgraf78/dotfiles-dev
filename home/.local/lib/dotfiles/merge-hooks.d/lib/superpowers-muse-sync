#!/usr/bin/env bash
# Reconcile obra/superpowers skills into the Muse skills store.
#
# The shdeps `obra/superpowers` checkout owns the skill sources; the store owns
# the installed copies. `sync` installs each upstream skill under a
# `superpowers-` prefix so upstream names never collide with local skills,
# refreshes changed installs in place, and prunes prefixed installs whose
# source left the checkout. `uninstall` removes only the prefixed set. Both
# entry points are idempotent: an unchanged skill is left alone, and
# uninstalling an already-clean store is a no-op.
#
# A missing `muse` CLI or checkout is a machine without this consumer, not a
# broken install, so both stay silent successes. A failed list, install,
# update, or uninstall is real drift and fails loudly so `dot update`
# reports it.

set -euo pipefail

_superpowers_prefix='superpowers-'
_superpowers_checkout="${SUPERPOWERS_SOURCE_DIR:-${HOME:?}/.local/share/obra/superpowers}"

# Print installed IDs carrying our prefix, one per line. Fails when the
# store cannot be listed: callers must not mistake "unknown" for "clean".
_superpowers_installed_ids() {
  local listing
  listing=$(muse skills list --source user) || return 1
  awk '$1 ~ /^superpowers-/ { print $1 }' <<<"$listing"
}

superpowers_sync() {
  command -v muse >/dev/null 2>&1 || return 0
  [[ -d $_superpowers_checkout/skills ]] || return 0
  local config_dir dir name id installed_dir installed
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/muse"
  for dir in "$_superpowers_checkout"/skills/*/; do
    [[ -d $dir ]] || continue
    name=$(basename "$dir")
    id="$_superpowers_prefix$name"
    installed_dir="$config_dir/skills/$id"
    # The store copy mirrors the source tree, so a recursive diff detects
    # "already current" without trusting the install provenance: a custom
    # XDG layout that misses just falls back to a converging reinstall.
    if [[ -d $installed_dir ]] &&
      diff -rq "$dir" "$installed_dir" >/dev/null 2>&1; then
      continue
    fi
    muse skills install "$dir" --scope user --name "$id" --force
  done
  installed=$(_superpowers_installed_ids) || return 1
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    [[ -d $_superpowers_checkout/skills/${id#"$_superpowers_prefix"} ]] ||
      muse skills uninstall "$id"
  done <<<"$installed"
}

superpowers_uninstall() {
  command -v muse >/dev/null 2>&1 || return 0
  local installed id
  installed=$(_superpowers_installed_ids) || return 1
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    muse skills uninstall "$id"
  done <<<"$installed"
}

case ${1:-} in
  sync) superpowers_sync ;;
  uninstall) superpowers_uninstall ;;
  *)
    printf 'usage: %s sync|uninstall\n' "${BASH_SOURCE[0]##*/}" >&2
    exit 2
    ;;
esac
