#!/usr/bin/env bash
# sley-provider-hook — activate one of Sley's repository-owned Git hooks.

set -u

hook_name=${1:-}
case "$hook_name" in
  pre-commit | pre-merge-commit | pre-applypatch | prepare-commit-msg | commit-msg | sley-commit-gate)
    shift
    ;;
  *)
    echo "sley-provider-hook: unsupported Sley hook: ${hook_name:-<missing>}" >&2
    exit 1
    ;;
esac

# Sley owns the portable hook implementations. Dotfiles deliberately keeps
# only this activation shim so fixes to Git sequencing or readiness behavior
# are reusable by every Sley installation instead of being copied here.
#
# DOT_SLEY_ROOT is an integration-test/development escape hatch. Normal fleet
# installs ask shdeps, which owns the dependency's location (install root,
# development-clone precedence, host filters) and which `dot update` keeps
# current. Resolving the CLI selects the root for both artifacts; the base
# helper caches that answer, so a commit pays no shdeps process once warm.
if [ -n "${DOT_SLEY_ROOT:-}" ]; then
  sley_root=$DOT_SLEY_ROOT
else
  shdeps_assets=${HOME:?}/.local/lib/dotfiles/shdeps-assets.sh
  sley_cli=
  if [ -r "$shdeps_assets" ]; then
    # shellcheck source=/dev/null # base-owned helper, absent from this overlay.
    . "$shdeps_assets"
    sley_cli=$(dot_shdeps_dep_file cgraf78/sley bin/sley 2>/dev/null) || sley_cli=
  fi
  if [ -z "$sley_cli" ]; then
    {
      echo "sley-provider-hook: shdeps cannot resolve the Sley CLI (cgraf78/sley bin/sley)"
      echo "sley-provider-hook: run dot update, or set DOT_SLEY_ROOT to a Sley checkout while developing."
    } >&2
    exit 1
  fi
  sley_root=${sley_cli%/bin/sley}
fi
provider_hook=$sley_root/share/sley/hooks/git/$hook_name
sley_cli=$sley_root/bin/sley
if [ ! -x "$provider_hook" ]; then
  {
    echo "sley-provider-hook: Sley hook is missing or not executable: $provider_hook"
    echo "sley-provider-hook: run dot update, or set DOT_SLEY_ROOT to a Sley checkout while developing."
  } >&2
  exit 1
fi
if [ ! -x "$sley_cli" ]; then
  {
    echo "sley-provider-hook: Sley CLI is missing or not executable: $sley_cli"
    echo "sley-provider-hook: run dot update, or set DOT_SLEY_ROOT to a complete Sley checkout while developing."
  } >&2
  exit 1
fi

# The provider hooks intentionally invoke `sley` by name so they remain
# portable when installed outside dotfiles. Bind that lookup to the same root
# as the selected hook here; otherwise DOT_SLEY_ROOT could combine a new hook
# with an older fleet-installed CLI and fail only at runtime.
export PATH="$sley_root/bin${PATH:+:$PATH}"

# Git's hook wrappers must use the one dotfiles-owned policy adapter below.
# The adapter recognizes the base client's separate Git directory and HOME
# worktree; Sley's generic gate intentionally has no knowledge of that client
# repository layout.
hook_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 1
export SLEY_GIT_COMMIT_GATE="$hook_dir/sley-commit-gate"

exec "$provider_hook" "$@"
